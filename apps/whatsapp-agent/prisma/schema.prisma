  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  transcription AudioTranscription @relation(fields: [transcriptionId], references: [id], onDelete: Cascade)

  @@index([clientId, status, createdAt])
  @@index([clientId, transcriptionId])
  @@index([clientId, provider, createdAt])
}

model SearchIndex {
  id           String                  @id @default(cuid())
  clientId     String                  @db.Uuid
  entityType   String
  entityId     String
  title        String?
  body         String?                 @db.Text
  channel      String?
  source       String?
  language     String?
  searchVector Unsupported("tsvector")?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, entityType, entityId])
  @@index([clientId, entityType, createdAt])
  @@index([clientId, channel, createdAt])
  @@index([clientId, source, createdAt])
  @@index([clientId, language])
  @@index([clientId, createdAt])
}

model WebchatSite {
  id        String   @id @default(cuid())
  clientId  String   @db.Uuid
  name      String
  slug      String
  status    String   @default("inactive")
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  settings WebchatSettings?
  allowedDomains WebchatAllowedDomain[]
  visitors WebchatVisitor[]
  sessions WebchatSession[]

  @@unique([clientId, slug])
  @@index([clientId, status])
  @@index([clientId, updatedAt])
}

model WebchatSettings {
  id             String   @id @default(cuid())
  clientId       String   @db.Uuid
  siteId         String   @unique
  theme          Json?
  welcomeMessage String?
  collectName    Boolean  @default(true)
  collectEmail   Boolean  @default(false)
  collectPhone   Boolean  @default(false)
  allowAnonymous Boolean  @default(true)
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  site WebchatSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([clientId, siteId])
}

model WebchatAllowedDomain {
  id        String   @id @default(cuid())
  clientId  String   @db.Uuid
  siteId    String
  domain    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  site WebchatSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, domain])
  @@index([clientId, active])
  @@index([clientId, siteId])
}

model WebchatVisitor {
  id            String   @id @default(cuid())
  clientId      String   @db.Uuid
  siteId        String
  visitorIdHash String
  name          String?
  email         String?
  phone         String?
  metadata      Json?
  lastSeenAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  site WebchatSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  sessions WebchatSession[]

  @@unique([siteId, visitorIdHash])
  @@index([clientId, siteId])
  @@index([clientId, updatedAt])
}

model WebchatSession {
  id            String   @id @default(cuid())
  clientId      String   @db.Uuid
  siteId        String
  visitorId     String
  tokenHash     String   @unique
  status        String   @default("active")
  originDomain  String
  ipHash        String?
  userAgentHash String?
  expiresAt     DateTime
  lastSeenAt    DateTime @default(now())
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  site WebchatSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  visitor WebchatVisitor @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  @@index([clientId, siteId, status])
  @@index([clientId, expiresAt])
  @@index([visitorId, status])
}
