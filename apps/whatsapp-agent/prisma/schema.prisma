generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ClientStatus {
  ACTIVE
  INACTIVE
}

enum Direction {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  TEMPLATE
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  UNKNOWN
}

enum MessageStatus {
  RECEIVED
  SENT
  FAILED
}

enum HandoffStatus {
  NONE
  PENDING
  ACTIVE
}

model Client {
  id         String          @id @default(uuid())
  clientKey  String          @unique
  name       String
  status     ClientStatus    @default(ACTIVE)
  adminToken String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  phoneNumbers WaPhoneNumber[]
  contacts     Contact[]
  conversations Conversation[]
  inboundMessages InboundMessage[]
  outboundMessages OutboundMessage[]
  events        Event[]
  leads         Lead[]
  leadNotes     LeadNote[]
  users         User[]
  runtimeStates ConversationRuntimeState[]
  campaigns     Campaign[]
}

model User {
  id        String   @id @default(cuid())
  clientId  String   @db.Uuid
  name      String
  email     String
  role      String   @default("AGENT")
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, email])
  @@index([clientId, createdAt])
}

model WaPhoneNumber {
  id            String   @id @default(uuid())
  clientId      String
  phoneNumberId String   @unique
  display       String?
  createdAt     DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id])
}

model Contact {
  id        String   @id @default(uuid())
  clientId  String
  waId      String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id])

  @@unique([clientId, waId])
}

model Conversation {
  id               String   @id @default(uuid())
  clientId         String
  waId             String
  phoneNumberId    String?
  windowIsOpen     Boolean  @default(true)
  windowExpiresAt  DateTime?
  lastInboundAt    DateTime?
  lastOutboundAt   DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  client   Client    @relation(fields: [clientId], references: [id])
  messages Message[]

  @@unique([clientId, waId])
  @@index([clientId, waId])
}

model Message {
  id             String        @id @default(uuid())
  conversationId String
  direction      Direction
  messageId      String?
  waId           String
  type           MessageType
  intent         String?
  bodyText       String?
  templateName   String?
  templateLang   String?
  status         MessageStatus
  requestId      String?
  metaMessageId  String?
  createdAt      DateTime      @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([requestId])
  @@index([messageId])
  @@unique([direction, messageId])
}

model InboundMessage {
  id            String      @id @default(uuid())
  clientId      String
  phoneNumberId String?
  waId          String
  messageId     String
  type          MessageType
  bodyText      String?
  allowlistHit  Boolean
  requestId     String?
  rawPayload    Json?
  createdAt     DateTime    @default(now())

  client Client @relation(fields: [clientId], references: [id])

  @@index([requestId])
  @@unique([clientId, messageId])
}

model OutboundMessage {
  id            String        @id @default(uuid())
  clientId      String
  phoneNumberId String?
  waId          String
  messageId     String?
  type          MessageType
  status        MessageStatus
  bodyText      String?
  templateName  String?
  templateLang  String?
  requestId     String?
  metaMessageId String?
  errorBody     String?
  rawPayload    Json?
  createdAt     DateTime      @default(now())

  client Client @relation(fields: [clientId], references: [id])

  @@index([requestId])
  @@index([messageId])
  @@unique([clientId, messageId])
}

model Event {
  id             String   @id @default(uuid())
  clientId       String
  conversationId String?
  waId           String?
  messageId      String?
  requestId      String?
  eventName      String
  payloadJson    Json
  createdAt      DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id])

  @@index([requestId])
  @@index([messageId])
  @@index([clientId, eventName, createdAt])
  @@unique([clientId, eventName, requestId])
}

model ConversationRuntimeState {
  id                  String        @id @default(uuid())
  clientId            String        @db.Uuid
  waId                String
  conversationKey     String?
  firstSeenAt         DateTime?
  windowIsOpen        Boolean       @default(true)
  windowExpiresAt     DateTime?
  lastInboundAt       DateTime?
  lastOutboundAt      DateTime?
  lastInboundMessageId  String?
  lastOutboundMessageId String?
  intent              String?
  handoffStatus       HandoffStatus @default(NONE)
  handoffRequestedAt  DateTime?
  handoffActivatedAt  DateTime?
  handoffReleasedAt   DateTime?
  templateNeeded      Boolean       @default(false)
  templateSuggested   String?
  lastNeedAt          DateTime?
  lastIntent          String?
  leadRequestedAt     DateTime?
  leadCapturedAt      DateTime?
  demoStatus          String?
  lastDemoRequestedAt DateTime?
  lastDemoScheduledAt DateTime?
  demoPreferredSchedule String?
  lastHandoffDemoScheduledKey String?
  lastHandoffDemoScheduledAt  DateTime?
  flow                String?
  flowStep            Int?
  answers             Json?
  mode                String?
  assignedUserId      String?
  assignedTo          String?
  assignedAt          DateTime?
  version             Int           @default(0)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  client Client @relation(fields: [clientId], references: [id])

  @@unique([clientId, waId])
  @@index([clientId, waId])
}

model Campaign {
  id              String   @id @default(uuid())
  clientId        String   @db.Uuid
  name            String
  templateName    String
  status          String
  totalRecipients Int      @default(0)
  sentCount       Int      @default(0)
  blockedCount    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
  @@index([clientId, status, createdAt])
}

model Lead {
  id        String   @id @default(cuid())

  tenantId  String   @db.Uuid
  client    Client   @relation(fields: [tenantId], references: [id])

  waId      String

  name      String?
  phone     String?
  city      String?
  service   String?

  status    String   @default("NEW")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  notes     LeadNote[]

  @@unique([tenantId, waId])
  @@index([tenantId, createdAt])
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  tenantId  String   @db.Uuid
  body      String
  createdAt DateTime @default(now())

  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  client    Client   @relation(fields: [tenantId], references: [id])

  @@index([leadId, createdAt])
  @@index([tenantId, createdAt])
}
