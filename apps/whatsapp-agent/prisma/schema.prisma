generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ClientStatus {
  ACTIVE
  INACTIVE
}

enum Direction {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  TEMPLATE
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  LOCATION
  UNKNOWN
}

enum MessageStatus {
  RECEIVED
  SENT
  FAILED
}

enum HandoffStatus {
  NONE
  PENDING
  ACTIVE
}

enum ConversationOperationalStatus {
  WAITING
  IN_PROGRESS
  WAITING_USER
  CLOSED
}

enum TrainingContentType {
  VIDEO
  PDF
}

enum TrainingContentStatus {
  DRAFT
  PUBLISHED
}

model Client {
  id         String          @id @default(uuid()) @db.Uuid
  clientKey  String          @unique
  name       String
  status     ClientStatus    @default(ACTIVE)
  adminToken String?
  features   Json?
  profile    String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  phoneNumbers WaPhoneNumber[]
  contacts     Contact[]
  contactConsents ContactConsent[]
  conversations Conversation[]
  inboundMessages InboundMessage[]
  outboundMessages OutboundMessage[]
  events        Event[]
  leads         Lead[]
  leadNotes     LeadNote[]
  users         User[]
  authSessions  AppAuthSession[]
  passwordResetTokens PasswordResetToken[]
  pushSubscriptions PushSubscription[]
  mfaTotpSecrets MfaTotpSecret[]
  mfaRecoveryCodes MfaRecoveryCode[]
  mfaChallenges MfaChallenge[]
  runtimeStates ConversationRuntimeState[]
  departments   Department[]
  queues        Queue[]
  campaigns     Campaign[]
  campaignExecutionBatches CampaignExecutionBatch[]
  campaignExecutionBatchCampaigns CampaignExecutionBatchCampaign[]
  campaignExecutionJobs CampaignExecutionJob[]
  tenantCampaignExecutionLease TenantCampaignExecutionLease?
  templates     Template[]
  templateRequests TemplateRequest[]
  slaConfig      SLAConfig?
  retentionConfig RetentionConfig?
  operationalConfig TenantOperationalConfig?
  supportAccessGrants PlatformSupportAccessGrant[]
  platformSupportSessions PlatformSupportSession[]
  channelAccounts ChannelAccount[]
  conversationMetrics ConversationMetrics[]
  metaConfig    TenantMetaConfig?
  chatbotFlows  ChatbotFlow[]
  channelIdentities ContactChannelIdentity[]
  knowledgeBaseCollections KnowledgeBaseCollection[]
  knowledgeBaseArticles KnowledgeBaseArticle[]
  publicApiKeys PublicApiKey[]
  webhookEndpoints WebhookEndpoint[]
  webhookDeliveries WebhookDelivery[]
  webhookAttempts WebhookAttempt[]
  schedulingServices SchedulingService[]
  schedulingResources SchedulingResource[]
  schedulingAvailabilities SchedulingAvailability[]
  appointments Appointment[]
  appointmentReminders AppointmentReminder[]
  satisfactionQuestions SatisfactionQuestion[]
  satisfactionSurveys SatisfactionSurvey[]
  satisfactionResponses SatisfactionResponse[]
  webchatSites WebchatSite[]
  webchatSettings WebchatSettings[]
  webchatAllowedDomains WebchatAllowedDomain[]
  webchatVisitors WebchatVisitor[]
  webchatSessions WebchatSession[]
  audioTranscriptions AudioTranscription[]
  audioTranscriptionJobs AudioTranscriptionJob[]
  searchIndexes SearchIndex[]
  userDepartmentMemberships UserDepartmentMembership[]
  agentAvailabilities AgentAvailability[]
  departmentBusinessHours DepartmentBusinessHour[]
  departmentBusinessHourExceptions DepartmentBusinessHourException[]
  completedServiceSnapshots CompletedServiceSnapshot[]
}

model User {
  id        String   @id @default(cuid())
  clientId  String   @db.Uuid
  departmentId String?
  name      String
  email     String   @unique
  passwordHash String?
  role      String   @default("AGENT")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  authSessions AppAuthSession[]
  passwordResetTokens PasswordResetToken[]
  pushSubscriptions PushSubscription[]
  mfaTotpSecrets MfaTotpSecret[]
  mfaRecoveryCodes MfaRecoveryCode[]
  mfaChallenges MfaChallenge[]
  schedulingResources SchedulingResource[]
  appointmentsCreated Appointment[] @relation("AppointmentCreatedBy")
  appointmentsUpdated Appointment[] @relation("AppointmentUpdatedBy")
  satisfactionQuestionsCreated SatisfactionQuestion[] @relation("SatisfactionQuestionCreatedBy")
  satisfactionQuestionsUpdated SatisfactionQuestion[] @relation("SatisfactionQuestionUpdatedBy")
  satisfactionSurveysAssigned SatisfactionSurvey[] @relation("SatisfactionSurveyAssignedUser")
  departmentMemberships UserDepartmentMembership[]
  agentAvailabilities AgentAvailability[]
  supportAccessGrantsGranted PlatformSupportAccessGrant[] @relation("SupportAccessGrantedBy")
  supportAccessGrantsRevoked PlatformSupportAccessGrant[] @relation("SupportAccessRevokedBy")
  platformSupportSessions PlatformSupportSession[] @relation("PlatformSupportSessionUser")

  @@unique([clientId, email])
  @@index([clientId, createdAt])
  @@index([clientId, departmentId])
}

model AgentAvailability {
  id                    String   @id @default(cuid())
  clientId              String   @db.Uuid
  userId                String
  available             Boolean  @default(false)
  lastHeartbeatAt       DateTime?
  availabilityChangedAt DateTime @default(now())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clientId, userId])
  @@index([clientId, available, lastHeartbeatAt])
  @@index([userId])
}

model AppAuthSession {
  id           String   @id @default(cuid())
  clientId     String   @db.Uuid
  userId       String
  userAgent    String?
  ipHash       String?
  createdAt    DateTime @default(now())
  lastSeenAt   DateTime @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  revokeReason String?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId, userId, revokedAt])
  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model PlatformSupportAccessGrant {
  id              String   @id @default(cuid())
  clientId        String   @db.Uuid
  grantedByUserId String
  reason          String?
  scope           String   @default("ADMIN")
  createdAt       DateTime @default(now())
  expiresAt       DateTime
  revokedAt       DateTime?
  revokedByUserId String?
  revokeReason    String?

  client    Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  grantedBy User   @relation("SupportAccessGrantedBy", fields: [grantedByUserId], references: [id], onDelete: Restrict)
  revokedBy User?  @relation("SupportAccessRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)
  sessions  PlatformSupportSession[]

  @@index([clientId, expiresAt, revokedAt])
  @@index([clientId, createdAt])
  @@index([grantedByUserId, createdAt])
}

model PlatformSupportSession {
  id                  String   @id @default(cuid())
  grantId             String
  actingClientId      String   @db.Uuid
  supportClientId     String   @db.Uuid
  supportUserId       String
  sourceAppSessionId  String?
  createdAt           DateTime @default(now())
  expiresAt           DateTime
  lastSeenAt          DateTime @default(now())
  endedAt             DateTime?
  endReason           String?

  grant       PlatformSupportAccessGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  actingClient Client @relation(fields: [actingClientId], references: [id], onDelete: Cascade)
  supportUser  User   @relation("PlatformSupportSessionUser", fields: [supportUserId], references: [id], onDelete: Cascade)

  @@index([actingClientId, supportUserId, endedAt])
  @@index([grantId, endedAt])
  @@index([supportUserId, createdAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id              String   @id @default(cuid())
  clientId        String   @db.Uuid
  userId          String
  tokenHash       String   @unique
  requestedIpHash String?
  userAgent       String?
  createdAt       DateTime @default(now())
  expiresAt       DateTime
  usedAt          DateTime?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId, userId, expiresAt])
  @@index([expiresAt])
}

model ContactConsent {
  id                String    @id @default(cuid())
  clientId          String    @db.Uuid
  contactId         String?   @db.Uuid
  leadId            String?
  purpose           String
  status            String
  sourceChannel     String?
  sourceProvider    String?
  source            String?
  textVersion       String?
  textHash          String?
  acceptedAt        DateTime?
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  client  Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  lead    Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([clientId, purpose, status])
  @@index([clientId, contactId, purpose, status])
  @@index([clientId, leadId, purpose, status])
  @@index([clientId, updatedAt])
}

model PushSubscription {
  id          String   @id @default(cuid())
  clientId    String   @db.Uuid
  userId      String
  endpoint    String   @unique
  p256dh      String
  auth        String
  userAgent   String?
  deviceLabel String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  revokedAt   DateTime?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId, userId, revokedAt])
  @@index([clientId, revokedAt])
  @@index([updatedAt])
}

model MfaTotpSecret {
  id               String    @id @default(cuid())
  clientId         String    @db.Uuid
  userId           String
  secretCiphertext String    @db.Text
  keyVersion       String
  enabled          Boolean   @default(false)
  enrolledAt       DateTime?
  lastUsedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clientId, userId])
  @@index([clientId, enabled])
  @@index([userId])
}

model MfaRecoveryCode {
  id        String    @id @default(cuid())
  clientId  String    @db.Uuid
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clientId, userId, codeHash])
  @@index([clientId, userId, usedAt])
}

model MfaChallenge {
  id                 String    @id @default(cuid())
  clientId           String    @db.Uuid
  userId             String
  challengeTokenHash String    @unique
  expiresAt          DateTime
  attempts           Int       @default(0)
  status             String    @default("pending")
  ipHash             String?
  userAgentHash      String?
  createdAt          DateTime  @default(now())
  verifiedAt         DateTime?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId, userId, status])
  @@index([expiresAt])
}

model WaPhoneNumber {
  id            String   @id @default(uuid()) @db.Uuid
  clientId      String @db.Uuid
  phoneNumberId String   @unique
  display       String?
  createdAt     DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id])
}

enum ContactLifecycleStatus {
  PROVISIONAL
  ACTIVE
}

model Contact {
  id                 String   @id @default(uuid()) @db.Uuid
  clientId           String @db.Uuid
  waId               String
  name               String?
  channel            String?
  provider           String?
  channelAccountId   String?
  externalUserHash   String?
  externalUserRef    String?
  legacyWaId         String?
  lifecycle          ContactLifecycleStatus @default(ACTIVE)
  operationallyExcludedAt DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id])
  channelIdentities ContactChannelIdentity[]
  consents ContactConsent[]
  appointments Appointment[]
  satisfactionSurveys SatisfactionSurvey[]
  satisfactionResponses SatisfactionResponse[]

  @@unique([clientId, waId])
  @@index([clientId, lifecycle])
  @@index([clientId, operationallyExcludedAt])
  @@index([clientId, channel, provider, channelAccountId])
}

model Conversation {
  id               String   @id @default(uuid()) @db.Uuid
  clientId         String @db.Uuid
  departmentId     String?
  waId             String
  waIdCanonical    String?
  phoneNumberId    String?
  channel          String?
  provider         String?
  channelAccountId String?
  externalUserHash String?
  externalUserRef  String?
  legacyWaId       String?
  windowIsOpen     Boolean  @default(true)
  windowExpiresAt  DateTime?
  firstAssignedAt  DateTime?
  firstResponseAt  DateTime?
  lastResponseAt   DateTime?
  closedAt         DateTime?
  lastInboundAt    DateTime?
  lastOutboundAt   DateTime?
  deletedAt        DateTime?
  anonymizedAt     DateTime?
  historyVisibleAfter DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  client   Client                 @relation(fields: [clientId], references: [id])
  department Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  messages Message[]
  metrics  ConversationMetrics?
  appointments Appointment[]
  satisfactionSurveys SatisfactionSurvey[]
  satisfactionResponses SatisfactionResponse[]

  @@unique([clientId, waId])
  @@index([clientId, waId])
  @@index([clientId, waIdCanonical])
  @@index([clientId, channel, provider, channelAccountId, externalUserHash])
  @@index([clientId, channel, updatedAt])
  @@index([clientId, channel, closedAt])
  @@index([clientId, channel, deletedAt])
  @@index([clientId, closedAt])
  @@index([clientId, deletedAt])
  @@index([clientId, departmentId])
  @@index([clientId, firstAssignedAt])
}

model Message {
  id             String        @id @default(uuid()) @db.Uuid
  conversationId String @db.Uuid
  direction      Direction
  messageId      String?
  waId           String
  type           MessageType
  intent         String?
  bodyText       String?
  templateName   String?
  templateLang   String?
  status         MessageStatus
  requestId      String?
  metaMessageId  String?
  createdAt      DateTime      @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([requestId])
  @@index([messageId])
  @@unique([direction, messageId])
}

model InboundMessage {
  id            String      @id @default(uuid()) @db.Uuid
  clientId      String @db.Uuid
  phoneNumberId String?
  waId          String
  waIdCanonical String?
  messageId     String
  channel       String?
  provider      String?
  channelAccountId String?
  externalUserHash String?
  externalUserRef  String?
  externalMessageId String?
  legacyWaId    String?
  type          MessageType
  bodyText      String?
  allowlistHit  Boolean
  requestId     String?
  rawPayload    Json?
  createdAt     DateTime    @default(now())

  client Client @relation(fields: [clientId], references: [id])

  @@index([requestId])
  @@index([clientId, waIdCanonical, createdAt])
  @@index([clientId, channel, provider, channelAccountId, externalUserHash, createdAt])
  @@index([clientId, channel, externalMessageId])
  @@unique([clientId, messageId])
}

model OutboundMessage {
  id            String        @id @default(uuid()) @db.Uuid
  clientId      String @db.Uuid
  phoneNumberId String?
  waId          String
  waIdCanonical String?
  messageId     String?
  channel       String?
  provider      String?
  channelAccountId String?
  externalUserHash String?
  externalUserRef  String?
  externalMessageId String?
  legacyWaId    String?
  type          MessageType
  status        MessageStatus
  bodyText      String?
  templateName  String?
  templateLang  String?
  requestId     String?
  metaMessageId String?
  errorBody     String?
  rawPayload    Json?
  createdAt     DateTime      @default(now())

  client Client @relation(fields: [clientId], references: [id])

  @@index([requestId])
  @@index([messageId])
  @@index([clientId, waIdCanonical, createdAt])
  @@index([clientId, channel, provider, channelAccountId, externalUserHash, createdAt])
  @@index([clientId, channel, externalMessageId])
  @@index([clientId, channel, status, createdAt])
  @@unique([clientId, messageId])
}

model Event {
  id             String   @id @default(uuid()) @db.Uuid
  clientId       String @db.Uuid
  conversationId String?
  waId           String?
  waIdCanonical  String?
  messageId      String?
  requestId      String?
  eventName      String
  payloadJson    Json
  createdAt      DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id])

  @@index([requestId])
  @@index([messageId])
  @@index([clientId, eventName, createdAt])
  @@index([clientId, waIdCanonical, createdAt])
  @@unique([clientId, eventName, requestId])
}

model TrainingContent {
  id                String                @id @default(uuid())
  contentId         String                @unique
  type              TrainingContentType
  title             String
  description       String?
  category          String
  sortOrder         Int                   @default(0)
  status            TrainingContentStatus @default(DRAFT)
  storageKey        String                @unique
  originalFilename  String
  mimeType          String
  sizeBytes         Int
  downloadable      Boolean               @default(false)
  publishedAt       DateTime?
  createdByUserId   String?
  updatedByUserId   String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([status])
  @@index([category, sortOrder])
}

model RetentionConfig {
  id            String   @id @default(cuid())
  clientId      String   @unique @db.Uuid
  retentionDays Int      @default(90)
  createdAt     DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model TenantOperationalConfig {
  id            String   @id @default(cuid())
  clientId      String   @unique @db.Uuid
  config        Json
  schemaVersion Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model ChannelAccount {
  id                        String   @id @default(cuid())
  clientId                  String   @db.Uuid
  channel                   String
  provider                  String
  displayName               String?
  channelAccountId          String
  externalAccountIds        Json?
  externalBusinessId        String?
  metadata                  Json?
  enabled                   Boolean  @default(false)
  automationEnabled         Boolean  @default(false)
  runtimeEnabled            Boolean  @default(false)
  inboundPersistenceEnabled Boolean  @default(false)
  outboundEnabled           Boolean  @default(false)
  aiEnabled                 Boolean  @default(false)
  handoffEnabled            Boolean  @default(false)
  status                    String   @default("pending")
  tokenStatus               String   @default("missing")
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  client  Client                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  aliases ChannelAccountAlias[]
  secrets ChannelAccountSecret[]

  @@unique([clientId, provider, channel, channelAccountId])
  @@index([clientId, channel, provider])
  @@index([channel, provider, channelAccountId])
  @@index([status])
}

model ChannelAccountAlias {
  id               String   @id @default(cuid())
  channelAccountId String
  alias            String
  aliasType        String   @default("externalAccountId")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  channelAccount ChannelAccount @relation(fields: [channelAccountId], references: [id], onDelete: Cascade)

  @@unique([channelAccountId, alias])
  @@index([alias])
  @@index([aliasType])
}

model ChannelAccountSecret {
  id               String   @id @default(cuid())
  channelAccountId String
  secretKind       String
  secretHash       String?
  secretCiphertext String?
  encryptionKeyRef String?
  status           String   @default("missing")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  channelAccount ChannelAccount @relation(fields: [channelAccountId], references: [id], onDelete: Cascade)

  @@unique([channelAccountId, secretKind])
  @@index([secretKind, status])
  @@index([secretHash])
}

model ConversationRuntimeState {
  id                  String        @id @default(uuid())
  clientId            String        @db.Uuid
  waId                String
  waIdCanonical       String?
  conversationKey     String?
  channel             String?
  provider            String?
  channelAccountId    String?
  externalUserHash    String?
  externalUserRef     String?
  legacyWaId          String?
  firstSeenAt         DateTime?
  windowIsOpen        Boolean       @default(true)
  windowExpiresAt     DateTime?
  lastInboundAt       DateTime?
  lastOutboundAt      DateTime?
  lastInboundMessageId  String?
  lastOutboundMessageId String?
  intent              String?
  handoffStatus       HandoffStatus @default(NONE)
  handoffRequestedAt  DateTime?
  handoffActivatedAt  DateTime?
  handoffReleasedAt   DateTime?
  templateNeeded      Boolean       @default(false)
  templateSuggested   String?
  lastNeedAt          DateTime?
  lastIntent          String?
  leadRequestedAt     DateTime?
  leadCapturedAt      DateTime?
  demoStatus          String?
  lastDemoRequestedAt DateTime?
  lastDemoScheduledAt DateTime?
  demoPreferredSchedule String?
  lastHandoffDemoScheduledKey String?
  lastHandoffDemoScheduledAt  DateTime?
  flow                String?
  flowStep            Int?
  chatbotNodeId       String?
  chatbotActive       Boolean       @default(false)
  answers             Json?
  mode                String?
  assignedUserId      String?
  assignedTo          String?
  assignedAt          DateTime?
  departmentId        String?
  queueId             String?
  status              ConversationOperationalStatus?
  closedAt            DateTime?
  version             Int           @default(0)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  client Client @relation(fields: [clientId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  queue Queue? @relation(fields: [queueId], references: [id], onDelete: SetNull)
  assignments ConversationAssignment[]

  @@unique([clientId, waId])
  @@index([clientId, waId])
  @@index([clientId, waIdCanonical])
  @@index([clientId, channel, provider, channelAccountId, externalUserHash])
  @@index([clientId, channel, status])
  @@index([clientId, channel, assignedUserId, status])
  @@index([clientId, channel, queueId, status])
  @@index([clientId, status])
  @@index([clientId, assignedUserId, status])
  @@index([clientId, queueId, status])
}

model ContactChannelIdentity {
  id               String   @id @default(cuid())
  clientId         String   @db.Uuid
  contactId        String?  @db.Uuid
  channel          String
  provider         String
  channelAccountId String
  externalUserHash String
  externalUserRef  String?
  legacyWaId       String?
  displayName      String?
  firstSeenAt      DateTime @default(now())
  lastSeenAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  client  Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  leads   Lead[]

  @@unique([clientId, channel, provider, channelAccountId, externalUserHash])
  @@index([clientId, contactId])
  @@index([clientId, channel, provider, channelAccountId])
  @@index([clientId, lastSeenAt])
}

model Department {
  id                 String   @id @default(cuid())
  name               String
  slug               String
  clientId           String   @db.Uuid
  operationalQueueId String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  operationalQueue Queue? @relation("DepartmentOperationalQueue", fields: [clientId, id, operationalQueueId], references: [clientId, departmentId, id], onDelete: Restrict, onUpdate: Cascade)
  users  User[]
  conversations Conversation[]
  queues Queue[]
  runtimeStates ConversationRuntimeState[]
  schedulingServices SchedulingService[]
  schedulingResources SchedulingResource[]
  appointments Appointment[]
  satisfactionSurveys SatisfactionSurvey[]
  userMemberships UserDepartmentMembership[]
  businessHours DepartmentBusinessHour[]
  businessHourExceptions DepartmentBusinessHourException[]

  @@unique([clientId, name])
  @@unique([clientId, slug])
  @@index([clientId, createdAt])
  @@index([operationalQueueId])
}

model UserDepartmentMembership {
  id           String   @id @default(cuid())
  clientId     String   @db.Uuid
  userId       String
  departmentId String
  isPrimary    Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  client     Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([userId, departmentId])
  @@index([clientId, userId])
  @@index([clientId, departmentId])
  @@index([clientId, departmentId, isActive])
}

model DepartmentBusinessHour {
