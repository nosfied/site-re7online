generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ClientStatus {
  ACTIVE
  INACTIVE
}

enum Direction {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  TEMPLATE
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  UNKNOWN
}

enum MessageStatus {
  RECEIVED
  SENT
  FAILED
}

enum HandoffStatus {
  NONE
  PENDING
  ACTIVE
}

enum ConversationOperationalStatus {
  WAITING
  IN_PROGRESS
  WAITING_USER
  CLOSED
}

model Client {
  id         String          @id @default(uuid())
  clientKey  String          @unique
  name       String
  status     ClientStatus    @default(ACTIVE)
  adminToken String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  phoneNumbers WaPhoneNumber[]
  contacts     Contact[]
  conversations Conversation[]
  inboundMessages InboundMessage[]
  outboundMessages OutboundMessage[]
  events        Event[]
  leads         Lead[]
  leadNotes     LeadNote[]
  users         User[]
  runtimeStates ConversationRuntimeState[]
  departments   Department[]
  queues        Queue[]
  campaigns     Campaign[]
  templates     Template[]
  templateRequests TemplateRequest[]
  metaConfig    TenantMetaConfig?
}

model User {
  id        String   @id @default(cuid())
  clientId  String   @db.Uuid
  name      String
  email     String
  passwordHash String?
  role      String   @default("AGENT")
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, email])
  @@index([clientId, createdAt])
}

model WaPhoneNumber {
  id            String   @id @default(uuid())
  clientId      String
  phoneNumberId String   @unique
  display       String?
  createdAt     DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id])
}

model Contact {
  id        String   @id @default(uuid())
  clientId  String
  waId      String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id])

  @@unique([clientId, waId])
}

model Conversation {
  id               String   @id @default(uuid())
  clientId         String
  waId             String
  waIdCanonical    String?
  phoneNumberId    String?
  windowIsOpen     Boolean  @default(true)
  windowExpiresAt  DateTime?
  lastInboundAt    DateTime?
  lastOutboundAt   DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  client   Client    @relation(fields: [clientId], references: [id])
  messages Message[]

  @@unique([clientId, waId])
  @@index([clientId, waId])
  @@index([clientId, waIdCanonical])
}

model Message {
  id             String        @id @default(uuid())
  conversationId String
  direction      Direction
  messageId      String?
  waId           String
  type           MessageType
  intent         String?
  bodyText       String?
  templateName   String?
  templateLang   String?
  status         MessageStatus
  requestId      String?
  metaMessageId  String?
  createdAt      DateTime      @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([requestId])
  @@index([messageId])
  @@unique([direction, messageId])
}

model InboundMessage {
  id            String      @id @default(uuid())
  clientId      String
  phoneNumberId String?
  waId          String
  waIdCanonical String?
  messageId     String
  type          MessageType
  bodyText      String?
  allowlistHit  Boolean
  requestId     String?
  rawPayload    Json?
  createdAt     DateTime    @default(now())

  client Client @relation(fields: [clientId], references: [id])

  @@index([requestId])
  @@index([clientId, waIdCanonical, createdAt])
  @@unique([clientId, messageId])
}

model OutboundMessage {
  id            String        @id @default(uuid())
  clientId      String
  phoneNumberId String?
  waId          String
  waIdCanonical String?
  messageId     String?
  type          MessageType
  status        MessageStatus
  bodyText      String?
  templateName  String?
  templateLang  String?
  requestId     String?
  metaMessageId String?
  errorBody     String?
  rawPayload    Json?
  createdAt     DateTime      @default(now())

  client Client @relation(fields: [clientId], references: [id])

  @@index([requestId])
  @@index([messageId])
  @@index([clientId, waIdCanonical, createdAt])
  @@unique([clientId, messageId])
}

model Event {
  id             String   @id @default(uuid())
  clientId       String
  conversationId String?
  waId           String?
  waIdCanonical  String?
  messageId      String?
  requestId      String?
  eventName      String
  payloadJson    Json
  createdAt      DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id])

  @@index([requestId])
  @@index([messageId])
  @@index([clientId, eventName, createdAt])
  @@index([clientId, waIdCanonical, createdAt])
  @@unique([clientId, eventName, requestId])
}

model ConversationRuntimeState {
  id                  String        @id @default(uuid())
  clientId            String        @db.Uuid
  waId                String
  waIdCanonical       String?
  conversationKey     String?
  firstSeenAt         DateTime?
  windowIsOpen        Boolean       @default(true)
  windowExpiresAt     DateTime?
  lastInboundAt       DateTime?
  lastOutboundAt      DateTime?
  lastInboundMessageId  String?
  lastOutboundMessageId String?
  intent              String?
  handoffStatus       HandoffStatus @default(NONE)
  handoffRequestedAt  DateTime?
  handoffActivatedAt  DateTime?
  handoffReleasedAt   DateTime?
  templateNeeded      Boolean       @default(false)
  templateSuggested   String?
  lastNeedAt          DateTime?
  lastIntent          String?
  leadRequestedAt     DateTime?
  leadCapturedAt      DateTime?
  demoStatus          String?
  lastDemoRequestedAt DateTime?
  lastDemoScheduledAt DateTime?
  demoPreferredSchedule String?
  lastHandoffDemoScheduledKey String?
  lastHandoffDemoScheduledAt  DateTime?
  flow                String?
  flowStep            Int?
  answers             Json?
  mode                String?
  assignedUserId      String?
  assignedTo          String?
  assignedAt          DateTime?
  departmentId        String?
  queueId             String?
  status              ConversationOperationalStatus?
  closedAt            DateTime?
  version             Int           @default(0)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  client Client @relation(fields: [clientId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  queue Queue? @relation(fields: [queueId], references: [id], onDelete: SetNull)
  assignments ConversationAssignment[]

  @@unique([clientId, waId])
  @@index([clientId, waId])
  @@index([clientId, waIdCanonical])
  @@index([clientId, status])
  @@index([clientId, assignedUserId, status])
  @@index([clientId, queueId, status])
}

model Department {
  id        String   @id @default(cuid())
  name      String
  clientId  String   @db.Uuid
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  queues Queue[]
  runtimeStates ConversationRuntimeState[]

  @@unique([clientId, name])
  @@index([clientId, createdAt])
}

model Queue {
  id           String   @id @default(cuid())
  name         String
  departmentId String
  clientId     String   @db.Uuid
  createdAt    DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  runtimeStates ConversationRuntimeState[]

  @@unique([clientId, departmentId, name])
  @@index([clientId, createdAt])
  @@index([departmentId, createdAt])
}

model ConversationAssignment {
  id             String   @id @default(cuid())
  conversationId String
  fromUserId     String?
  toUserId       String?
  assignedAt     DateTime @default(now())

  conversation ConversationRuntimeState @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, assignedAt])
}

model Campaign {
  id              String   @id @default(uuid())
  clientId        String   @db.Uuid
  templateId      String?
  name            String
  templateName    String
  status          String
  totalRecipients Int      @default(0)
  sentCount       Int      @default(0)
  blockedCount    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  template Template? @relation(fields: [templateId], references: [id])

  @@index([clientId, createdAt])
  @@index([clientId, status, createdAt])
  @@index([templateId])
}

model Template {
  id              String   @id @default(cuid())
  clientId        String   @db.Uuid
  name            String
  category        String
  submittedCategory String?
  wasRecategorized Boolean  @default(false)
  language        String
  status          String
  content         String
  variables       Json?
  metaTemplateId  String?
  rejectionReason String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  campaigns Campaign[]

  @@unique([clientId, name])
  @@index([clientId, status])
  @@index([clientId, name])
}

model TemplateRequest {
  id        String   @id @default(cuid())
  clientId  String   @db.Uuid
  name      String
  content   String
  variables Json?
  category  String
  status    String
  notes     String?
  createdBy String?
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, status])
}

model Lead {
  id        String   @id @default(cuid())

  tenantId  String   @db.Uuid
  client    Client   @relation(fields: [tenantId], references: [id])

  waId      String
  waIdCanonical String?

  name      String?
  phone     String?
  city      String?
  service   String?

  status    String   @default("NEW")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  notes     LeadNote[]

  @@unique([tenantId, waId])
  @@index([tenantId, createdAt])
  @@index([tenantId, waIdCanonical])
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  tenantId  String   @db.Uuid
  body      String
  createdAt DateTime @default(now())

  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  client    Client   @relation(fields: [tenantId], references: [id])

  @@index([leadId, createdAt])
  @@index([tenantId, createdAt])
}

model TenantMetaConfig {
  id                  String   @id @default(uuid())
  clientId            String   @unique @db.Uuid
  businessToken       String?
  businessId          String?
  businessPortfolioId String?
  wabaId              String?
  phoneNumberId       String?
  rawPayload          Json
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([phoneNumberId])
  @@index([wabaId])
}
