{
  "name": "whatsapp-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:departments": "tsx scripts/seed-departments.ts",
    "dev:webhook": "node scripts/send-signed-webhook.mjs",
    "dev:webhook:file": "WEBHOOK_BODY_FILE=scripts/payload.sample.json node scripts/send-signed-webhook.mjs",
    "dev:webhook:allow": "FROM=558499049614 node scripts/send-signed-webhook.mjs",
    "dev:webhook:block": "FROM=5511999999999 node scripts/send-signed-webhook.mjs",
    "dev:webhook:re7": "FROM=558499049614 PHONE_NUMBER_ID=1018032104719713 node scripts/send-signed-webhook.mjs",
    "dev:webhook:help": "node scripts/send-signed-webhook.mjs --help",
    "media:cleanup": "node scripts/cleanup-local-media.mjs",
    "departments:normalize-operational": "node scripts/normalize-operational-department.mjs",
    "retention:run": "tsx scripts/run-retention.ts",
    "followup:run": "node --import tsx scripts/run-followups.mjs",
    "demo:seed": "node scripts/seed-demo.mjs",
    "state:backfill": "node scripts/backfill-runtime-state.mjs",
    "state:validate": "node scripts/validate-runtime-state.mjs",
    "test:last-outbound": "tsx scripts/test-last-outbound-at.ts",
    "pm2:start": "pm2 start ecosystem.config.cjs --env production",
    "pm2:reload": "pm2 reload ecosystem.config.cjs --env production"
  },
  "dependencies": {
    "@prisma/client": "^6.16.1",
    "dotenv": "^16.6.1",
    "openai": "^6.17.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/dotenv": "^6.1.1",
    "@types/node": "^25.3.0",
    "@types/ws": "^8.18.1",
    "prisma": "^6.16.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
