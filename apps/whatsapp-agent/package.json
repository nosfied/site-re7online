{
  "name": "whatsapp-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:departments": "tsx scripts/seed-departments.ts",
    "dev:webhook": "node scripts/send-signed-webhook.mjs",
    "dev:webhook:file": "WEBHOOK_BODY_FILE=scripts/payload.sample.json node scripts/send-signed-webhook.mjs",
    "dev:webhook:allow": "FROM=558499049614 node scripts/send-signed-webhook.mjs",
    "dev:webhook:block": "FROM=5511999999999 node scripts/send-signed-webhook.mjs",
    "dev:webhook:re7": "FROM=558499049614 PHONE_NUMBER_ID=1018032104719713 node scripts/send-signed-webhook.mjs",
    "dev:webhook:help": "node scripts/send-signed-webhook.mjs --help",
    "media:cleanup": "node scripts/cleanup-local-media.mjs",
    "template-media:cleanup": "node --import tsx scripts/cleanup-template-media.ts",
    "backup:postgres": "bash scripts/backup-postgres.sh",
    "backup:postgres:alerted": "bash scripts/backup-postgres-with-alert.sh",
    "backup:postgres:check": "node --import tsx scripts/postgres-backup-alert.ts check",
    "backup:evidence": "node --import tsx scripts/backup-evidence.ts",
    "load-test:tenant:bootstrap": "node --import tsx scripts/load-test-tenant-bootstrap.ts",
    "load-test:fixtures": "node scripts/load-test-fixtures.mjs",
    "departments:normalize-operational": "node scripts/normalize-operational-department.mjs",
    "retention:run": "tsx scripts/run-retention.ts",
    "storage:report": "tsx scripts/storage-report.ts",
    "events:retention": "tsx scripts/events-retention.ts",
    "tenant-config:backfill": "node --import tsx scripts/backfill-tenant-operational-config.ts",
    "channel-accounts:backfill": "node --import tsx scripts/channel-accounts-backfill.ts",
    "channel-accounts:shadow:compare": "node --import tsx scripts/channel-accounts-shadow-compare.ts",
    "tenants-json:retirement:check": "node --import tsx scripts/tenants-json-retirement-check.ts",
    "test:tenants-json-retirement-selection": "node --import tsx --test src/config/tenantJsonRetirementSelection.test.ts",
    "channel-latency:summary": "node --import tsx scripts/channel-latency-summary.ts",
    "channels:backfill": "node --import tsx scripts/channels-backfill.ts",
    "channels:backfill:dry-run": "node --import tsx scripts/channels-backfill-dry-run.ts",
    "smoke:webhook:staging": "node --import tsx scripts/staging-webhook-smoke.ts",
    "multichannel:backfill:dry-run": "node --import tsx scripts/channels-backfill-dry-run.ts",
    "evaluation:replay": "node --import tsx scripts/evaluation-replay.ts",
    "evaluation:export-conversation": "node --import tsx scripts/evaluation-export-conversation.ts",
    "evaluation:validate-candidate": "node --import tsx scripts/evaluation-validate-candidate.ts",
    "evaluation:import-candidate": "node --import tsx scripts/evaluation-import-candidate.ts",
    "followup:run": "node --import tsx scripts/run-followups.mjs",
    "scheduling-reminders:shadow": "node --import tsx scripts/run-scheduling-reminders-shadow.ts",
    "scheduling-reminders:send": "node --import tsx scripts/run-scheduling-reminders-send.ts",
    "audio-transcriptions:shadow": "node --import tsx scripts/audio-transcriptions-shadow.ts",
    "audio-transcriptions:process": "node --import tsx scripts/audio-transcriptions-process.ts",
    "search:index-audio": "node --import tsx scripts/search-index-audio.ts",
    "search:index-shadow": "node --import tsx scripts/search-index-shadow.ts",
    "webhooks:shadow": "node --import tsx scripts/webhooks-shadow.ts",
    "webhooks:dispatch": "node --import tsx scripts/webhooks-dispatch.ts",
    "demo:seed": "node scripts/seed-demo.mjs",
    "demo:readiness": "node --import tsx scripts/demo-tenant-readiness.ts",
    "demo:provision": "node --import tsx scripts/provision-demo-tenant.ts",
    "meta:readiness": "node --import tsx scripts/meta-tenant-readiness.ts",
    "demo:seed:boa-esperanca-poc": "node scripts/seed-boa-esperanca-poc.mjs",
    "demo:status:boa-esperanca-poc": "node scripts/seed-boa-esperanca-poc.mjs status",
    "demo:seed:re7-screenshots": "node scripts/seed-re7-demo-screenshots.mjs",
    "tenant:intake-flow:configure": "node --import tsx scripts/configure-tenant-intake-flow.ts",
    "state:backfill": "node scripts/backfill-runtime-state.mjs",
    "state:validate": "node scripts/validate-runtime-state.mjs",
    "test:last-outbound": "tsx scripts/test-last-outbound-at.ts",
    "pm2:start": "pm2 start ecosystem.config.cjs --env production",
    "pm2:reload": "pm2 reload ecosystem.config.cjs --env production",
    "channels:shadow:compare": "node --import tsx scripts/channels-shadow-compare.ts",
    "channels:shadow:rollout-check": "node --import tsx scripts/channels-shadow-rollout-check.ts",
    "channels:shadow:repair-missing": "node --import tsx scripts/channels-shadow-repair-missing.ts",
    "channels:shadow:release-anonymized-identity": "node --import tsx scripts/channels-shadow-release-anonymized-identity.ts",
    "meta:profiles:backfill": "node --import tsx scripts/meta-contact-profile-backfill.ts",
    "push:vapid:generate": "node --import tsx scripts/generate-vapid-keys.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.1",
    "@types/web-push": "^3.6.4",
    "dotenv": "^16.6.1",
    "nodemailer": "^8.0.7",
    "openai": "^6.17.0",
    "web-push": "^3.6.7",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/dotenv": "^6.1.1",
    "@types/node": "^25.3.0",
    "@types/nodemailer": "^8.0.0",
    "@types/ws": "^8.18.1",
    "prisma": "^6.16.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
