PORT=4000
ENV=dev
DATABASE_URL=postgresql://user:password@localhost:5432/re7_whatsapp_agent?schema=public
ADMIN_TOKEN=changeme
CLIENT_ID=default

# Meta Cloud API
WHATSAPP_VERIFY_TOKEN=changeme
WHATSAPP_ACCESS_TOKEN=changeme
WHATSAPP_PHONE_NUMBER_ID=1234567890
WHATSAPP_API_VERSION=v24.0
# Opcional (obrigatorio em producao para validar assinatura do webhook)
META_APP_SECRET=

# Allowlist (CSV)
WHATSAPP_ALLOWLIST=5584999999999,5584888888888
WHATSAPP_ADMIN_ALLOWLIST=5584999999999

# Echo / dedup
WHATSAPP_ECHO_ENABLED=false
WHATSAPP_DEFAULT_REPLY="Olá! Em breve nosso atendimento estará disponível por aqui."
WHATSAPP_SANDBOX=false
WHATSAPP_SANDBOX_TO=5584999049614
WHATSAPP_OUT_OF_WINDOW_TEMPLATE=hello_world
WHATSAPP_DEDUP_WINDOW_SECONDS=86400
DISABLE_DEBUG_COMMANDS=true
OUTBOUND_TEMPLATE_FALLBACK=false
OUTBOUND_TEMPLATE_DEFAULT_NAME=hello_world
OUTBOUND_TEMPLATE_DEFAULT_LANG=pt_BR
# Fallback explícito (plano B), ex.: hello_world / en_US
OUTBOUND_TEMPLATE_FALLBACK_NAME=
OUTBOUND_TEMPLATE_FALLBACK_LANG=
OUTBOUND_TEXT_ENABLED=true
# Handoff notify (demo scheduled -> attendant)
HANDOFF_ENABLED=false
HANDOFF_ATTENDANT_WAID=
HANDOFF_NOTIFY_TEMPLATE_NAME=
HANDOFF_NOTIFY_TEMPLATE_LANG=
# Use templates aprovados na Meta
# Exemplo: {"pricing":{"name":"re7_pricing_v1","language":"pt_BR"}}
OUTBOUND_TEMPLATE_INTENT_MAP_JSON=
# Templates por cliente (JSON):
# {"default":{"default":{"name":"template_default","language":"pt_BR"},"pricing":{"name":"template_pricing","language":"pt_BR"}}}
OUTBOUND_TEMPLATES_BY_CLIENT_JSON=

# OpenAI (AgentBrain)
OPENAI_API_KEY=
WHATSAPP_AI_ENABLED=false
WHATSAPP_AI_MODEL=gpt-4.1-mini
WHATSAPP_AI_MAX_OUTPUT_TOKENS=200
WHATSAPP_AI_TEMPERATURE=0.4
WHATSAPP_AI_SYSTEM_PROMPT=
WHATSAPP_AI_TIMEOUT_MS=8000
