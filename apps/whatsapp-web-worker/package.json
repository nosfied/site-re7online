{
  "name": "whatsapp-web-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json --noCheck",
    "prestart": "prisma generate --schema ../whatsapp-agent/prisma/schema.prisma && node scripts/copy-prisma-client.mjs",
    "start": "node dist/whatsapp-web-worker/src/index.js",
    "worker": "node dist/whatsapp-web-worker/src/index.js",
    "dev": "tsx src/index.ts",
    "test": "node --import tsx --test src/whatsappWebSessionWorker.test.ts src/web-session/baileysSocketFactory.test.ts src/web-session/dedicatedPgAdvisoryLock.test.ts src/web-session/sensitiveConsoleFilter.test.ts",
    "db:generate": "prisma generate --schema ../whatsapp-agent/prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.16.1",
    "@whiskeysockets/baileys": "7.0.0-rc13",
    "dotenv": "^16.6.1",
    "nodemailer": "^8.0.11",
    "pg": "^8.23.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "@types/pg": "^8.21.0",
    "prisma": "^6.16.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
