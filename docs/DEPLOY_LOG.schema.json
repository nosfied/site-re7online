{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://re7online.com/schemas/deploy-log-v1.json",
  "title": "Converta deploy record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "recordType", "releaseId", "targetCommit", "components", "result", "evidence"],
  "properties": {
    "schemaVersion": {"const": 1},
    "recordType": {"enum": ["DEPLOYMENT", "HISTORICAL_BOUNDARY"]},
    "releaseId": {"type": "string", "minLength": 1},
    "targetCommit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "components": {"type": "array", "items": {"enum": ["api", "frontend", "worker"]}, "uniqueItems": true},
    "result": {"enum": ["DEPLOYED", "ROLLED_BACK", "ROLLBACK_FAILED", "HISTORICAL_INCOMPLETE"]},
    "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "deployedAtUtc": {"type": ["string", "null"], "format": "date-time"},
    "runtimeManifestSha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "pm2DumpSha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "rollbackResult": {"type": ["string", "null"]},
    "notes": {"type": "string"}
  }
}
