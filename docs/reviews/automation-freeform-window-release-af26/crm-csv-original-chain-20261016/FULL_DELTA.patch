+def request(root, action, guard=None, now=None, driver=None):
+    root = Path(root)
+    ops.Operations(root, driver).restore_proof()
+    now = time.time() if now is None else now
+    guard = ops.System().guard() if guard is None else guard
+    bound = bindings(root, action, guard)
+    previous = latest_attempt(root, action)
+    if previous:
+        prior = json.loads(request_path(root, action, previous).read_text())
+        ops.require(all(prior.get(k) == v for k, v in bound.items()), 'renewal_binding_drift')
+        proof = proof_path(root, action, previous)
+        consumed = consumed_path(root, action, previous)
+        ops.require(not (proof.exists() and consumed.exists()), 'invalid_proof_history')
+        prior_binding = {'request': prior}
+        if proof.exists():
+            prior_binding = json.loads(proof.read_text())
+            ops.require(prior_binding.get('request') == prior, 'prior_proof_request_mismatch')
+            observed = prior_binding['observedAt']
+            ops.require(now - observed > MAX_AGE, 'prior_proof_still_valid')
+        elif consumed.exists():
+            prior_binding = json.loads(consumed.read_text())
+            ops.require(prior_binding.get('request') == prior, 'prior_proof_request_mismatch')
+            ops.require(action.startswith('start:'), 'completed_action_cannot_renew')
+        else:
+            ops.require(now - prior['requestedAt'] > MAX_AGE, 'prior_request_still_valid')
+        reconfirm_for_renewal(root, action, driver or DelegatedSystem(root, action), prior_binding)
+    attempt = previous + 1
+    p = request_path(root, action, attempt)
+    value = dict(bound, nonce=secrets.token_hex(24), requestedAt=now, attempt=attempt)
+    with p.open('x') as f:
+        json.dump(value, f)
+    return value
+
+
+def record(root, action, nft, nonce, now=None, guard=None):
+    now = time.time() if now is None else now
+    attempt = latest_attempt(root, action)
+    ops.require(attempt > 0, 'owner_request_missing')
+    r = json.loads(request_path(root, action, attempt).read_text())
+    ops.require(r['attempt'] == attempt and r['nonce'] == nonce, 'owner_request_replay_or_wrong_nonce')
+    current = bindings(root, action, ops.System().guard() if guard is None else guard)
+    ops.require(r.get('root') == current['root'] and r.get('action') == action,
+                'owner_request_binding_drift')
+    ops.require(all(r.get(k) == v for k, v in current.items()),
+                'owner_request_generation_or_configuration_drift')
+    ops.require(0 <= now - r['requestedAt'] <= MAX_AGE, 'owner_request_expired')
+    validate_nft(action, nft)
+    value = {'request': r, 'observedAt': now, 'nft': nft}
+    p = proof_path(root, action, attempt)
+    with p.open('x') as f:
+        json.dump(value, f)
+    return hashlib.sha256(p.read_bytes()).hexdigest()
+
+
+def validate_nft(action, nft):
+    if action in ABSENT:
+        ops.require('nftables' in nft, 'invalid_nft_proof')
+        ops.require(not any(x.get('table', {}).get('name') ==
+                            're7_campaign_transition' for x in nft['nftables']),
+                    'transition_fence_still_present')
+    else:
+        ops.check_fence(nft)
+
