+        ops.require(Path('/etc/cron.d/re7-converta-backup').read_bytes() ==
+                    (self.window / 're7-converta-backup.before').read_bytes(), 'system_cron_drift')
+        ops.require(self.d.run(['crontab', '-l']).encode() ==
+                    (self.window / 'deploy.crontab.before').read_bytes(), 'deploy_cron_drift')
+        self.d.run(['crontab', '-'], (self.window / 'deploy.crontab.window').read_text())
+        ops.require(self.d.run(['crontab', '-l']).encode() ==
+                    (self.window / 'deploy.crontab.window').read_bytes(), 'deploy_cron_install_failed')
+
+    def enter(self):
+        ops.Operations(self.root, self.d).restore_proof()
+        ops.Operations(self.root, self.d).guard()
+        self.d.containment(self.window)
+
+    def unfence(self):
+        ops.Operations(self.root, self.d).restore_proof()
+        self.d.containment(self.window)
+        operation = ops.Operations(self.root, self.d)
+        operation.guard()
