+    require(len(sys.argv) in (2, 3), 'baseline_exact_arguments_required')
+    validate_preparation(sys.argv[1], [sys.argv[2]] if len(sys.argv) == 3 else None)
+    print('BASELINE_CONTRACT_PASS')
