+"""Split-role adapter: no sudo execution, unchanged executor exit barriers."""
+import hashlib
+import fcntl
+import json
+import os
+import re
+import secrets
+import sys
+import time
+from contextlib import contextmanager
+from pathlib import Path
+
+import ops
+BOUND_PREPARATION = Path('/opt/re7online/backups/converta-persistent/preparations/incident-csv-operational-review-v3-20261016')
+from baseline_contract import operational, validate_preparation
+
+ACTIONS = {'preflight', 'prepare-containment', 'contain', 'stop-pair',
+           'recover-partial', 'start:re7-whatsapp-agent',
+           'start:re7-whatsapp-web-worker',
+           'unfence', 'verify-unfenced', 'restore-controls'}
+ABSENT = {'preflight', 'prepare-containment', 'verify-unfenced', 'restore-controls'}
+MAX_AGE = 300
+
+
+@contextmanager
+def operation_lock(root):
+    # Shared by switch and every return mode on this host. A stopped process
+    # releases flock, but the history file remains; no stale-lock deletion.
+    path = Path(root).parent / 'window' / 'operator.lock'
+    with path.open('a+') as lock:
+        fcntl.flock(lock.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
+        try:
+            yield
+        finally:
+            fcntl.flock(lock.fileno(), fcntl.LOCK_UN)
+
+
+def request_path(root, action, attempt=None):
+    ops.require(action in ACTIONS, 'unknown_delegated_action')
+    base = Path(root) / ('owner-request-' + action.replace(':', '-') + '.json')
+    if attempt is None:
+        attempt = latest_attempt(root, action) or 1
+    return base if attempt == 1 else base.with_name(base.stem + f'.renewal-{attempt:04d}.json')
+
+
+def proof_path(root, action, attempt=None):
+    p = request_path(root, action, attempt)
+    return p.with_name(p.name.replace('owner-request-', 'owner-proof-'))
+
+
+def consumed_path(root, action, attempt=None):
+    return proof_path(root, action, attempt).with_suffix('.consumed.json')
+
+
+def latest_attempt(root, action):
+    base = Path(root) / ('owner-request-' + action.replace(':', '-') + '.json')
+    attempts = {1} if base.exists() else set()
+    prefix = base.stem + '.renewal-'
+    for p in base.parent.glob(prefix + '*.json'):
+        suffix = p.name[len(prefix):-5]
+        ops.require(bool(re.fullmatch(r'[0-9]{4}', suffix)), 'invalid_proof_history')
+        attempts.add(int(suffix))
+    if not attempts:
+        return 0
+    ops.require(attempts == set(range(1, max(attempts) + 1)), 'proof_history_gap')
+    return max(attempts)
+
+
+def bindings(root, action, guard):
+    validate_preparation(Path(root).parent, [Path(root).name])
+    root = Path(root)
+    guard = ops.guard_state(guard)
+    result = {'action': action, 'root': str(root.resolve()),
+            'guardGeneration': guard['generation'],
+            'direction': json.loads((root / 'plan.private.json').read_text())['direction'],
+            'configurationHash': hashlib.sha256((root / 'candidate.config.private.json').read_bytes()).hexdigest()}
+    if action == 'start:' + ops.WORKER:
+        binding_file = root.parent / 'window' / 'db-owner-bindings.private.json'
+        result['dbOwnerBindingsHash'] = hashlib.sha256(binding_file.read_bytes()).hexdigest()
+    result['executionIntentSha256'] = __phase_authority__.execution_hash()
+    return result
+
