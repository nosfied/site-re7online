+def reconfirm_for_renewal(root, action, driver, prior_binding):
+    """Read-only gate before issuing a new nonce after an expired/failed proof."""
+    root = Path(root)
+    op = ops.Operations(root, driver)
+    op.restore_proof()
+    if action == 'preflight':
+        ops.Controls(root, driver).scheduled().verify('before')
+        ops.require(not (root / 'old-exit-confirmed.json').exists(), 'operation_already_progressed')
+        live = {a['name']: a for a in driver.apps()}
+        ops.require(set(live) == ops.NAMES, 'preflight_process_drift')
+        for n, cfg in op.source.items():
+            op.config(live[n], cfg)
+        return
+    if action in {'prepare-containment', 'contain', 'stop-pair', 'stop-front',
+                  'recover-partial', 'unfence'} or action.startswith('start:'):
+        op.guard()
+    if action in {'contain', 'stop-pair', 'stop-front', 'recover-partial', 'unfence'} or action.startswith('start:'):
+        driver.renewal_containment(op.window)
+    if action.startswith('start:'):
+        name = action.split(':', 1)[1]
+        ops.require(not (root / ('start-intent-' + name + '.json')).exists() and
+                    not (root / ('started-' + name + '.json')).exists(),
+                    'start_already_attempted')
+        op.certificate('frontend-exit-confirmed.json' if name == ops.FRONT else
+                       'old-exit-confirmed.json', name)
+        expected = {ops.API: {ops.FRONT}, ops.WORKER: {ops.FRONT, ops.API},
+                    ops.FRONT: {ops.API, ops.WORKER}}[name].copy()
+        if op.plan.get('frontendAbsentAtRecovery') and name != ops.FRONT:
+            expected.discard(ops.FRONT)
+        live = {a['name']: a for a in driver.apps()}
+        ops.require(set(live) == expected, 'successor_order_or_owner_conflict')
+        if ops.FRONT in expected and not (root / ('started-' + ops.FRONT + '.json')).exists():
+            prior = op.certificate('old-exit-confirmed.json', name)['frontend']
+            ops.require(prior and live[ops.FRONT]['pid'] == prior['pid'] and
+                        ops.same_process(prior['identity'], driver.identity(live[ops.FRONT]['pid'])),
+                        'frontend_identity_changed')
+        for n in expected:
+            op.config(live[n], op.source[n] if n == ops.FRONT else op.target[n])
+            marker = root / ('started-' + n + '.json')
+            if marker.exists():
+                saved = json.loads(marker.read_text())
+                ops.require(saved['pid'] == live[n]['pid'] and
+                            ops.same_process(saved['identity'], driver.identity(live[n]['pid'])),
+                            'successor_identity_changed')
+        ops.require(driver.path_exists(op.target[name]['script']), 'successor_artifact_missing')
+        driver.validate_bindings(op.window, {name: op.target[name]})
+        op.db_gate_for_start(name, live, binding_proof=prior_binding)
+    elif action in {'stop-pair', 'stop-front', 'recover-partial'}:
+        prefix = 'front' if action == 'stop-front' else 'pair'
+        ops.require(not (root / (prefix + '-stop-start.json')).exists() and
+                    not (root / ('frontend-exit-confirmed.json' if action == 'stop-front'
+                                else 'old-exit-confirmed.json')).exists(),
+                    'stop_already_attempted')
+        if action == 'stop-front':
+            op.certificate('old-exit-confirmed.json', ops.FRONT)
+        live = {a['name']: a for a in driver.apps()}
+        ops.require(set(live) <= ops.NAMES, 'unknown_pm2_process')
+        if action == 'recover-partial':
+            ops.require(op.plan.get('recovery'), 'recovery_not_bound')
+            prior = json.loads((root.parent / 'switch' / 'stop-start.json').read_text())
+            op.old_absent(prior)
+            if op.plan.get('frontendAbsentAtRecovery'):
+                prior_front = json.loads((root.parent / 'switch' / 'front-stop-start.json').read_text())
+                op.old_absent(prior_front)
+        else:
+            ops.require(set(live) == ops.NAMES, 'unexpected_partial_composition')
+        for n, app in live.items():
+            cfg = op.target[n] if action == 'stop-front' and n != ops.FRONT else op.source[n]
+            op.config(app, cfg)
+    elif action == 'unfence':
+        ops.require(not (root / 'owner-unfence-authorized.json').exists(), 'unfence_already_attempted')
+        op.certificate('old-exit-confirmed.json', ops.API)
+        live = {a['name']: a for a in driver.apps()}
+        ops.require(set(live) == ops.NAMES, 'incomplete_process_set')
+        for n, cfg in op.target.items():
+            op.config(live[n], cfg, fresh=True)
+        driver.validate_bindings(op.window, op.target)
+        if op.source[ops.FRONT] != op.target[ops.FRONT]:
+            op.certificate('frontend-exit-confirmed.json', ops.FRONT)
+        elif not (root / ('started-' + ops.FRONT + '.json')).exists():
+            prior = op.certificate('old-exit-confirmed.json', ops.FRONT)['frontend']
+            ops.require(prior and live[ops.FRONT]['pid'] == prior['pid'] and
+                        ops.same_process(prior['identity'], driver.identity(live[ops.FRONT]['pid'])),
+                        'frontend_identity_changed')
+    elif action == 'prepare-containment':
+        ops.require(not (root / 'old-exit-confirmed.json').exists(), 'operation_already_progressed')
+        ops.require(driver.run(['crontab', '-l']).encode() ==
+                    (op.window / 'deploy.crontab.before').read_bytes(), 'prepare_already_applied')
+        ops.require(Path('/etc/cron.d/re7-converta-backup').read_bytes() ==
+                    (op.window / 're7-converta-backup.before').read_bytes(), 'system_cron_drift')
+        initial = operational(json.loads((op.window / 'initial.private.json').read_text()))
+        ops.require(driver.run(['systemctl', 'show', 'pm2-deploy.service',
+                                '--property=ActiveState,UnitFileState']) == initial['supervision'],
+                    'supervision_drift')
+    elif action == 'contain':
+        ops.require(not (root / 'old-exit-confirmed.json').exists(), 'operation_already_progressed')
+        ops.require(driver.run(['crontab', '-l']).encode() ==
+                    (op.window / 'deploy.crontab.window').read_bytes(), 'window_cron_drift')
+    elif action == 'verify-unfenced':
+        ops.require((root / 'owner-unfence-authorized.json').exists() and
+                    not (root / 'after-unfence.json').exists(), 'unfence_stage_drift')
+        live = {a['name']: a for a in driver.apps()}
+        ops.require(set(live) == ops.NAMES, 'incomplete_process_set')
+        for n, cfg in op.target.items():
+            op.config(live[n], cfg, fresh=True)
+    elif action == 'restore-controls':
+        ops.require((root / 'after-unfence.json').exists(), 'technical_validation_missing')
+        ops.require(driver.run(['crontab', '-l']).encode() ==
+                    (op.window / 'deploy.crontab.window').read_bytes(), 'controls_already_restored')
+        ops.require(Path('/etc/cron.d/re7-converta-backup').read_bytes() ==
+                    (op.window / 're7-converta-backup.before').read_bytes(), 'system_cron_restore_failed')
+        initial = operational(json.loads((op.window / 'initial.private.json').read_text()))
+        ops.require(driver.run(['systemctl', 'show', 'pm2-deploy.service',
+                                '--property=ActiveState,UnitFileState']) == initial['supervision'],
+                    'supervision_restore_failed')
+
