+    def guard(self):
+        return guard_state(json.loads(Path('/var/lib/re7/campaign-operations/state.json').read_text()))
+
+    def identity(self, pid):
+        try:
+            a = Path('/proc', str(pid), 'stat').read_text().rsplit(')', 1)[1].split()
+            return {'state': a[0], 'ticks': a[19]}
+        except FileNotFoundError:
+            return None
+
+    def tree(self, pid):
+        result = {str(pid): self.identity(pid)}
+        while True:
+            before = len(result)
+            for line in self.run(['ps', '-eo', 'pid,ppid', '--no-headers']).splitlines():
+                child, parent = line.split()
+                if parent in result and child not in result:
+                    result[child] = self.identity(int(child))
+            if before == len(result):
+                return result
+
+    def socket_ids(self, trees):
+        found = set()
+        for tree in trees:
+            for pid in tree:
+                folder = Path('/proc', pid, 'fd')
+                if not folder.exists():
+                    continue
+                for f in folder.iterdir():
+                    try:
+                        target = os.readlink(f)
+                        if target.startswith('socket:['):
+                            found.add(target[8:-1])
+                    except FileNotFoundError:
+                        pass
+        return sorted(found)
+
+    def sockets_present(self, captured):
+        found = set()
+        for net in ['tcp', 'tcp6', 'udp', 'udp6', 'unix']:
+            for line in Path('/proc/net', net).read_text().splitlines()[1:]:
+                a = line.split()
+                found.add(a[6] if net == 'unix' else a[9])
+        return bool(set(captured) & found)
