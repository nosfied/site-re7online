require('./execution-check.cjs')();
const fs=require('fs'),assert=require('assert'),cp=require('child_process');process.umask(0o077);
const p=__dirname;const a=require(p+'/return.ecosystem.config.cjs').apps[0];
(async()=>{assert(fs.existsSync(p+'/backup-manifest.json'));const bindings=require('./preparation-bindings.cjs');bindings.proofs(p);const sql='BEGIN READ ONLY; SET LOCAL statement_timeout=10000; '+bindings.sql+'; ROLLBACK;';const q=JSON.parse(cp.execFileSync('docker',['exec','-i','wa-agent-postgres','psql','-X','-U','wa_agent','-d','whatsapp_agent','-Atq','-v','ON_ERROR_STOP=1'],{input:sql,encoding:'utf8'}));bindings.noWork(q);const url='http://127.0.0.1:3001/admin/ops/campaign-execution',headers={'X-Admin-Token':a.env.ADMIN_TOKEN,'Content-Type':'application/json'};let r=await fetch(url,{headers});assert.equal(r.status,200);const before=await r.json();assert(before.available&&!before.ledgerFault&&before.tasks.length===0);if(!before.open){assert(before.drained);fs.writeFileSync(p+'/drain-result.json',JSON.stringify({initiallyClosed:true,open:false,generation:before.generation,drained:true,tasks:0,ledgerFault:null}));return;}fs.writeFileSync(p+'/guard-before.json',JSON.stringify(before));r=await fetch(url,{method:'POST',headers,body:JSON.stringify({open:false,generation:before.generation,reason:'Owner-authorized 6683 API correction V4 return-partial; preparation incident-6683-v4-sequenced-20261003T165710Z'})});const result=await r.json();fs.writeFileSync(p+'/guard-close-response.json',JSON.stringify({status:r.status,result}));assert.equal(r.status,200);r=await fetch(url,{headers});const g=await r.json();assert(r.status===200&&g.available&&!g.open&&g.drained&&!g.ledgerFault&&g.tasks.length===0);fs.copyFileSync('/var/lib/re7/campaign-operations/state.json',p+'/guard-closed.private.json');const report={utc:new Date().toISOString(),available:g.available,open:g.open,drained:g.drained,generation:g.generation,tasks:g.tasks.length,ledgerFault:g.ledgerFault,queue:q};fs.writeFileSync(p+'/drain-result.json',JSON.stringify(report,null,2));console.log(JSON.stringify(report));})().catch(e=>{console.error(e.message);process.exitCode=1;});
