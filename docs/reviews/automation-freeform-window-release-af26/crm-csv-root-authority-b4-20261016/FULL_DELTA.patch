+def topo(graph):
+    result=[];active=[];done=set()
+    def visit(n):
+        require(n in graph,'dependency_missing:'+n)
+        require(n not in active,'dependency_cycle:'+' -> '.join(active+[n]))
+        if n in done:return
+        active.append(n)
+        for child in sorted(graph[n]):visit(child)
