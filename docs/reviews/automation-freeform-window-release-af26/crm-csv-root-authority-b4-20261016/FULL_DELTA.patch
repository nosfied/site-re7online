+    second = _one(system, pid, marker, host, port, bindings)
+    require(first == second, 'db_owner_changed_during_check')
+    return {'apiConnections': len([r for r in first[1]['tcp'] if r['peer'] == [host, port]]),
+            'proxyPid': first[2]['identity']['pid']}
