+        authority.require(tuple(json.loads(rest[1]))==context.identity, 'bootstrap_authority_replaced')
+        rest=rest[3:]
+    loader=Loader(context,entry,trusted_modules={"authority":authority,"child_transport":transport})
+    if argv[0]=='python':
