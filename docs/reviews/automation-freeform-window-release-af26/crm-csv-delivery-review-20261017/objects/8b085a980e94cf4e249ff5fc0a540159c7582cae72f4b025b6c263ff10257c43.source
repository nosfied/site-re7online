import os,stat
from pathlib import Path
def metadata(s):
    return tuple((getattr(s, 'st_' + k) for k in ('dev', 'ino', 'mode', 'uid', 'gid', 'nlink', 'size', 'mtime_ns', 'ctime_ns')))

def read(path, limit=8 * 1024 * 1024):
    path = Path(path)
    for p in (path, *path.parents):
        if p.is_symlink():
            raise RuntimeError('source_symlink')
    s = path.lstat()
    if not stat.S_ISREG(s.st_mode) or s.st_nlink != 1 or s.st_size > limit:
        raise RuntimeError('source_type_size')
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    try:
        if metadata(os.fstat(fd)) != metadata(s):
            raise RuntimeError('source_replaced')
        with os.fdopen(fd, 'rb', closefd=False) as f:
            raw = f.read(limit + 1)
        if len(raw) > limit or metadata(os.fstat(fd)) != metadata(s) or metadata(path.lstat()) != metadata(s):
            raise RuntimeError('source_changed')
        return raw
    finally:
        os.close(fd)
