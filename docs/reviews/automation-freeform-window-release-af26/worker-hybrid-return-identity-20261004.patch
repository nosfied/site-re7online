+import assert from "node:assert/strict";
+import test from "node:test";
+import type { PrismaClient } from "@prisma/client";
+import { prepareAcceptedCampaignReturnConversation, resolveInboundConversationIdentity } from "./inboundConversationIdentity.js";
+import { resolveWebSessionTransportRecipientWaId } from "../web-session/webSessionOutboundService.js";
+
+test("minimum worker sends to the provider-observed alias of its own Web account", async () => {
+  const row = { provider: "web_session", channelAccountId: "web-account", legacyWaId: "558494786787", deletedAt: null, anonymizedAt: null };
+  const prisma = { conversation: { findUnique: async () => row } } as unknown as PrismaClient;
+  const params = { prisma, clientId: "tenant", waId: "5584994786787", channelAccountId: "web-account" };
+  assert.equal(await resolveWebSessionTransportRecipientWaId(params), "558494786787");
+  assert.equal(await resolveWebSessionTransportRecipientWaId({ ...params, channelAccountId: "other" }), params.waId);
+});
+
+const modern = "5584994786787";
+const legacy = "558494786787";
+
+function fixture(rows: Array<Record<string, unknown>>) {
+  const publicNumber = "558499995328";
+  const matches = (row: Record<string, unknown>, clause: Record<string, unknown>) =>
+    Object.entries(clause).some(([field, condition]) => {
+      const value = String(row[field] ?? "");
+      if (typeof condition === "object" && condition !== null) {
+        const filter = condition as { in?: string[]; endsWith?: string };
+        return (filter.in?.includes(value) ?? false) || (filter.endsWith ? value.endsWith(filter.endsWith) : false);
+      }
+      return value === condition;
+    });
+  const prisma = {
+    conversation: {
+      findMany: async ({ where }: { where: { clientId: string; OR: Record<string, unknown>[] } }) =>
+        rows.filter((row) => row.clientId === where.clientId && !row.deletedAt && !row.anonymizedAt && where.OR.some((clause) => matches(row, clause))),
+      findUnique: async ({ where }: { where: { id: string } }) => rows.find((row) => row.id === where.id) ?? null,
+    },
+    contact: { findFirst: async () => null },
+    tenantMetaConfig: {
+      findUnique: async () => ({ phoneNumberId: "meta-phone", businessToken: "synthetic", wabaId: "synthetic", rawPayload: { source: "fixture" } }),
+    },
+    waPhoneNumber: { findFirst: async () => ({ display: publicNumber, phoneNumberId: "meta-phone" }) },
+    tenantOperationalConfig: {
+      findUnique: async () => ({ config: { webSessionAuthorization: { status: "AUTHORIZED", authorizedNumberCanonical: publicNumber } } }),
+    },
+    channelAccount: { findMany: async () => [{ channelAccountId: "web-account" }] },
+  } as unknown as PrismaClient;
+  return prisma;
+}
+
+function row(waId: string, overrides: Record<string, unknown> = {}) {
+  return {
+    id: "conversation-1", clientId: "tenant-1", waId, waIdCanonical: waId,
+    provider: "meta", phoneNumberId: "meta-phone", channelAccountId: null,
+    deletedAt: null, anonymizedAt: null, updatedAt: new Date(), lastInboundAt: null, lastOutboundAt: null,
+    ...overrides,
+  };
+}
+
+test("confirmed hybrid account selects the existing conversation in both ninth-digit directions", async () => {
+  for (const [existing, incoming] of [[modern, legacy], [legacy, modern]]) {
+    const prisma = fixture([row(existing)]);
+    const result = await resolveInboundConversationIdentity(prisma, {
+      clientId: "tenant-1", waId: incoming, provider: "web_session", channelAccountId: "web-account",
+    });
+    assert.deepEqual(result, { waId: existing, reason: "resolved", conversationId: "conversation-1" });
+  }
+});
+
+test("minimum worker uses persisted winning key for an exact canonical alias and verifies account", async () => {
+  const prisma = fixture([row(legacy, { waIdCanonical: modern })]);
+  const allowed = await resolveInboundConversationIdentity(prisma, {
+    clientId: "tenant-1", waId: modern, provider: "web_session", channelAccountId: "web-account",
+  });
+  assert.deepEqual(allowed, { waId: legacy, reason: "resolved", conversationId: "conversation-1" });
+  const denied = await resolveInboundConversationIdentity(prisma, {
+    clientId: "tenant-1", waId: modern, provider: "web_session", channelAccountId: "other-account",
+  });
+  assert.equal(denied.reason, "unconfirmed_account");
+});
+
+test("Meta winner can reuse the Web conversation on the same confirmed public account", async () => {
+  const prisma = fixture([row(legacy, { provider: "web_session", phoneNumberId: null, channelAccountId: "web-account" })]);
+  assert.equal((await resolveInboundConversationIdentity(prisma, {
+    clientId: "tenant-1", waId: modern, provider: "meta", channelAccountId: "meta-phone",
+  })).waId, legacy);
+});
+
+test("tenant/account mismatch, ambiguity and anonymization never select a variant", async () => {
+  const request = { clientId: "tenant-1", waId: legacy, provider: "web_session" as const, channelAccountId: "web-account" };
+  assert.equal((await resolveInboundConversationIdentity(fixture([row(modern)]), { ...request, clientId: "tenant-2" })).reason, "unchanged");
+  assert.equal((await resolveInboundConversationIdentity(fixture([row(modern)]), { ...request, channelAccountId: "other-web-account" })).reason, "unconfirmed_account");
+  assert.equal((await resolveInboundConversationIdentity(fixture([row(modern, { phoneNumberId: "other-meta-phone" })]), request)).reason, "unconfirmed_account");
+  assert.equal((await resolveInboundConversationIdentity(fixture([row(modern), row(modern, { id: "conversation-2" })]), request)).reason, "ambiguous");
+  assert.equal((await resolveInboundConversationIdentity(fixture([row(modern, { anonymizedAt: new Date() })]), request)).reason, "unchanged");
+});
+
+test("minimum worker seeds only the accepted campaign's closed return destination before Web inbound", async () => {
+  const rows: Array<Record<string, unknown>> = [];
+  const runtimes: Array<Record<string, unknown>> = [];
+  const db: Record<string, unknown> = { ...fixture(rows) };
+  db.outboundMessage = { findMany: async () => [{
+    waId: modern, waIdCanonical: modern, phoneNumberId: "meta-phone",
+    messageId: "campaign.synthetic.1", templateName: "synthetic", createdAt: new Date("2026-10-04T10:00:00Z"),
+    rawPayload: { deliveryConversationPending: true, campaignId: "campaign-1",
+      returnDestination: { type: "human_department", departmentId: "department-1", queueId: "queue-1" } },
+  }] };
+  const tx = {
+    $executeRaw: async () => 1,
+    conversation: {
+      findFirst: async () => rows.length ? { id: rows[0]?.id } : null,
+      create: async ({ data }: { data: Record<string, unknown> }) => {
+        rows.push({ id: "conversation-1", updatedAt: new Date(), lastInboundAt: null,
+          deletedAt: null, anonymizedAt: null, channelAccountId: null, ...data });
+      },
+    },
+    conversationRuntimeState: {
+      create: async ({ data }: { data: Record<string, unknown> }) => { runtimes.push(data); },
+    },
+  };
+  db.$transaction = async (callback: (value: typeof tx) => Promise<unknown>) => callback(tx);
+  const result = await prepareAcceptedCampaignReturnConversation(db as unknown as PrismaClient, {
+    clientId: "tenant-1", clientKey: "tenant-1", waId: legacy,
+    provider: "web_session", channelAccountId: "web-account", inboundAt: new Date("2026-10-04T10:01:00Z"),
+  });
+  assert.equal(result.waId, modern);
+  assert.equal(rows.length, 1);
+  assert.equal(rows[0]?.windowIsOpen, false);
+  assert.equal(rows[0]?.departmentId, "department-1");
+  assert.equal(runtimes.length, 1);
+  assert.equal(runtimes[0]?.mode, "HUMAN");
+  assert.equal(runtimes[0]?.status, "WAITING");
+  assert.equal(runtimes[0]?.queueId, "queue-1");
+  assert.equal(runtimes[0]?.lastInboundAt, undefined);
+});
diff --git a/apps/whatsapp-agent/src/channels/inboundConversationIdentity.ts b/apps/whatsapp-agent/src/channels/inboundConversationIdentity.ts
new file mode 100644
index 0000000..3d60c20
--- /dev/null
+++ b/apps/whatsapp-agent/src/channels/inboundConversationIdentity.ts
@@ -0,0 +1,202 @@
+import { ConversationOperationalStatus, MessageStatus, Prisma, type PrismaClient } from "@prisma/client";
+import { withHybridConversationIdentityLock } from "./hybridConversationIdentityLock.js";
+import { resolveCampaignRecipientConversationTarget } from "../campaigns/campaignRecipientConversationBridge.js";
+import { getBrazilNinthDigitVariant } from "../crm/crmWhatsappIdentity.js";
+import { makeConversationKey } from "../storage/conversationKey.js";
+import { normalizeHybridWhatsappNumber, resolveHybridWhatsappIdentityStatus } from "../web-session/hybridIdentity.js";
+import { normalizeWaIdDigits } from "../utils/waid.js";
+
+// The minimum worker predates the API's return-destination materializer. Accept
+// only the two already validated, persisted campaign destination shapes.
+function parseOutboundReturnDestination(value: unknown) {
+  if (!value || typeof value !== "object" || Array.isArray(value)) return null;
+  const record = value as Record<string, unknown>;
+  const id = (field: unknown) => typeof field === "string" && field.trim() ? field.trim() : null;
+  if (record.type === "human_department") {
+    const departmentId = id(record.departmentId);
+    const queueId = id(record.queueId);
+    return departmentId && queueId ? { type: "human_department" as const, departmentId, queueId } : null;
+  }
+  if (record.type === "automated_flow") {
+    const flowId = id(record.flowId);
+    return flowId ? { type: "automated_flow" as const, flowId } : null;
+  }
+  return null;
+}
+
+/** Resolve an already existing conversation; never create or merge an identity. */
+export async function resolveInboundConversationIdentity(
+  prisma: PrismaClient,
+  input: {
+    clientId: string;
+    waId: string;
+    provider: "meta" | "web_session";
+    channelAccountId: string;
+  }
+) {
+  const waId = normalizeWaIdDigits(input.waId);
+  const target = await resolveCampaignRecipientConversationTarget(prisma, {
+    clientId: input.clientId,
+    inputWaId: waId,
+  });
+  if (target.resolved && target.matchedBy === "exact_conversation_waid" && target.conversationId) {
+    return { waId: target.winningWaId, reason: "resolved", conversationId: target.conversationId } as const;
+  }
+  if (!target.resolved || !target.conversationId) {
+    return { waId, reason: target.reason === "ambiguous" ? "ambiguous" : "unchanged" } as const;
+  }
+
+  // The numerical variant is only a candidate. Both transports must be bound
+  // to the same provider-confirmed public number and the precise live accounts.
+  const [candidate, hybrid, metaConfig, webAccounts] = await Promise.all([
+    prisma.conversation.findUnique({
+      where: { id: target.conversationId },
+      select: { clientId: true, waId: true, provider: true, phoneNumberId: true, channelAccountId: true, deletedAt: true, anonymizedAt: true },
+    }),
+    resolveHybridWhatsappIdentityStatus({ prisma, clientId: input.clientId }),
+    prisma.tenantMetaConfig.findUnique({ where: { clientId: input.clientId }, select: { phoneNumberId: true } }),
+    prisma.channelAccount.findMany({
+      where: { clientId: input.clientId, channel: "whatsapp", provider: "web_session", runtimeEnabled: true, status: { not: "archived_duplicate" } },
+      select: { channelAccountId: true },
+    }),
+  ]);
+  const webAccountId = webAccounts.length === 1 ? webAccounts[0]?.channelAccountId : null;
+  const metaPhoneNumberId = metaConfig?.phoneNumberId;
+  const accountIsCurrent = input.provider === "meta"
+    ? input.channelAccountId === metaPhoneNumberId
+    : input.channelAccountId === webAccountId;
+  const candidateIsCurrent = candidate?.provider === "meta"
+    ? candidate.phoneNumberId === metaPhoneNumberId
+    : candidate?.provider === "web_session" && candidate.channelAccountId === webAccountId;
+  const publicNumberConfirmed =
+    hybrid.meta.configured && hybrid.meta.canonicalNumber &&
+    hybrid.web.canonicalNumber && hybrid.web.status !== "RELEASED" &&
+    hybrid.web.status !== "INVALIDATED_BY_META_IDENTITY_CHANGE" &&
+    !hybrid.conflict && !hybrid.numberReplacement &&
+    normalizeHybridWhatsappNumber(hybrid.meta.canonicalNumber) ===
+      normalizeHybridWhatsappNumber(hybrid.web.canonicalNumber);
+  if (
+    !candidate || candidate.clientId !== input.clientId || candidate.deletedAt || candidate.anonymizedAt ||
+    !metaPhoneNumberId || !webAccountId || !accountIsCurrent || !candidateIsCurrent || !publicNumberConfirmed
+  ) {
+    return { waId, reason: "unconfirmed_account" } as const;
+  }
+  return { waId: target.winningWaId, reason: "resolved", conversationId: target.conversationId } as const;
+}
+
+/** A provider-accepted campaign can be answered before DELIVERED/READ arrives. */
+async function prepareAcceptedCampaignReturnConversationUnlocked(
+  prisma: PrismaClient,
+  input: {
+    clientId: string;
+    clientKey: string;
+    waId: string;
+    provider: "meta" | "web_session";
+    channelAccountId: string;
+    inboundAt: Date;
+  }
+) {
+  const existing = await resolveInboundConversationIdentity(prisma, input);
+  if (existing.reason !== "unchanged") return existing;
+  const waId = normalizeWaIdDigits(input.waId);
+  const variant = getBrazilNinthDigitVariant(waId);
+  const [hybrid, metaConfig, webAccounts] = await Promise.all([
+    resolveHybridWhatsappIdentityStatus({ prisma, clientId: input.clientId }),
+    prisma.tenantMetaConfig.findUnique({ where: { clientId: input.clientId }, select: { phoneNumberId: true } }),
+    prisma.channelAccount.findMany({
+      where: { clientId: input.clientId, channel: "whatsapp", provider: "web_session", runtimeEnabled: true, status: { not: "archived_duplicate" } },
+      select: { channelAccountId: true },
+    }),
+  ]);
+  const metaPhoneNumberId = metaConfig?.phoneNumberId;
+  const webAccountId = webAccounts.length === 1 ? webAccounts[0]?.channelAccountId : null;
+  if (!metaPhoneNumberId || !webAccountId || hybrid.conflict || hybrid.numberReplacement ||
+      !hybrid.meta.configured || !hybrid.meta.canonicalNumber ||
+      normalizeHybridWhatsappNumber(hybrid.meta.canonicalNumber) !==
+        normalizeHybridWhatsappNumber(hybrid.web.canonicalNumber) ||
+      hybrid.web.status === "RELEASED" || hybrid.web.status === "INVALIDATED_BY_META_IDENTITY_CHANGE" ||
+      (input.provider === "meta" && input.channelAccountId !== metaPhoneNumberId) ||
+      (input.provider === "web_session" && input.channelAccountId !== webAccountId)) {
+    return existing;
+  }
+  const outbounds = await prisma.outboundMessage.findMany({
+    where: {
+      clientId: input.clientId,
+      phoneNumberId: metaPhoneNumberId,
+      waId: { in: Array.from(new Set([waId, variant].filter(Boolean))) as string[] },
+      status: MessageStatus.SENT,
+      metaMessageId: { not: null },
+      createdAt: { lte: input.inboundAt },
+    },
+    orderBy: { createdAt: "desc" },
+    take: 3,
+    select: {
+      waId: true, waIdCanonical: true, phoneNumberId: true, messageId: true,
+      templateName: true, createdAt: true, rawPayload: true,
+    },
+  });
+  const pending = outbounds.filter((outbound) => {
+    const payload = outbound.rawPayload;
+    return payload && typeof payload === "object" && !Array.isArray(payload) &&
+      payload.deliveryConversationPending === true &&
+      typeof payload.campaignId === "string" &&
+      Boolean(parseOutboundReturnDestination(payload.returnDestination));
+  });
+  if (pending.length !== 1) return existing;
+  const outbound = pending[0]!;
+  const payload = outbound.rawPayload as Record<string, unknown>;
+  if (!outbound.messageId || !outbound.templateName) return existing;
+  const destination = parseOutboundReturnDestination(payload.returnDestination);
+  if (!destination) return existing;
+  try {
+    await prisma.$transaction(async (tx) => {
+      const current = await tx.conversation.findFirst({ where: {
+        clientId: input.clientId,
+        waId: { in: Array.from(new Set([waId, variant].filter(Boolean))) as string[] },
+      }, select: { id: true } });
+      if (current) return;
+      await tx.conversation.create({ data: {
+        clientId: input.clientId,
+        waId: outbound.waId,
+        waIdCanonical: outbound.waIdCanonical,
+        channel: "whatsapp",
+        provider: "meta",
+        phoneNumberId: outbound.phoneNumberId,
+        departmentId: destination.type === "human_department" ? destination.departmentId : null,
+        windowIsOpen: false,
+        lastOutboundAt: outbound.createdAt,
+      } });
+      await tx.conversationRuntimeState.create({ data: {
+        clientId: input.clientId,
+        waId: outbound.waId,
+        waIdCanonical: outbound.waIdCanonical,
+        conversationKey: makeConversationKey(input.clientKey, outbound.waId),
+        channel: "whatsapp",
+        provider: "meta",
+        firstSeenAt: outbound.createdAt,
+        lastOutboundAt: outbound.createdAt,
+        lastOutboundMessageId: outbound.messageId,
+        mode: destination.type === "human_department" ? "HUMAN" : "BOT",
+        status: destination.type === "human_department"
+          ? ConversationOperationalStatus.WAITING : ConversationOperationalStatus.WAITING_USER,
+        departmentId: destination.type === "human_department" ? destination.departmentId : null,
+        queueId: destination.type === "human_department" ? destination.queueId : null,
+        chatbotActive: destination.type === "automated_flow",
+        flow: destination.type === "automated_flow" ? `chatbot:${destination.flowId}` : null,
+        answers: {},
+      } });
+    });
+  } catch (error) {
+    if (!(error instanceof Prisma.PrismaClientKnownRequestError && error.code === "P2002")) throw error;
+  }
+  return resolveInboundConversationIdentity(prisma, input);
+}
+
+export async function prepareAcceptedCampaignReturnConversation(
+  prisma: PrismaClient,
+  input: Parameters<typeof prepareAcceptedCampaignReturnConversationUnlocked>[1]
+) {
+  return withHybridConversationIdentityLock(prisma, input, () =>
+    prepareAcceptedCampaignReturnConversationUnlocked(prisma, input)
+  );
+}
