+        try:
+            r=subprocess.run(argv,stdout=out,stderr=err,pass_fds=(tool_fd,image_fd),timeout=15,
+                             env={'PATH':'/usr/bin:/bin','LANG':'C'},preexec_fn=bounds,check=False)
+            code=r.returncode
