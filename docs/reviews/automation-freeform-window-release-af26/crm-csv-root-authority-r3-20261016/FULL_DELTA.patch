+def protected_directory(path):
+    path=Path(path)
+    for node in (path,*path.parents):
+        meta=node.lstat()
+        require(stat.S_ISDIR(meta.st_mode) and meta.st_uid==0 and not meta.st_mode&0o022,
+                'authority_root_directory')
+
