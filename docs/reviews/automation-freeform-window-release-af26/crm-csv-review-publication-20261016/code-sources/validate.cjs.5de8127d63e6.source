require('./execution-check.cjs')();
const bindings=require('./preparation-bindings.cjs');
const fs=require('fs'),cp=require('child_process'),assert=require('assert');process.umask(0o077);
const p=__dirname,apps=require(p+'/candidate.ecosystem.config.cjs').apps;
(async()=>{const health=[];for(const u of ['http://127.0.0.1:3001/health','https://converta.re7online.com/agent-api/health','https://api.re7online.com/health']){const r=await fetch(u,{signal:AbortSignal.timeout(8000)});const b=await r.json();assert(r.status===200&&b.ok&&b.db==='ok');health.push({url:u,status:r.status,ok:b.ok,db:b.db});}
const headers={'X-Admin-Token':apps[0].env.ADMIN_TOKEN};let r=await fetch('http://127.0.0.1:3001/admin/ops/campaign-execution',{headers});const g=await r.json();assert(r.status===200&&g.available&&!g.open&&g.drained&&!g.ledgerFault&&g.tasks.length===0&&g.build===apps[0].env.CAMPAIGN_BUILD_ID);const build=fs.readFileSync(apps[2].cwd+'/.next/BUILD_ID','utf8').trim();bindings.frontend(p,build);const front=[];for(const u of ['http://127.0.0.1:3000/app/inbox','https://converta.re7online.com/app/inbox','https://converta.re7online.com/app/settings/inbox']){r=await fetch(u,{signal:AbortSignal.timeout(8000)});const html=await r.text();assert.equal(r.status,200);assert(html.includes(build));front.push({url:u,status:r.status,buildPresent:true});}
const e=apps[1].env;const workerUrl='http://'+e.WHATSAPP_WEB_WORKER_CONTROL_HOST+':'+e.WHATSAPP_WEB_WORKER_CONTROL_PORT+'/health';r=await fetch(workerUrl,{headers:{Authorization:'Bearer '+e.WHATSAPP_WEB_WORKER_CONTROL_TOKEN},signal:AbortSignal.timeout(5000)});const wh=await r.json();assert(r.status===200&&wh.ok);
bindings.proofs(p);const sql=bindings.sql;const q=JSON.parse(cp.execFileSync('docker',['exec','-i','wa-agent-postgres','psql','-X','-U','wa_agent','-d','whatsapp_agent','-Atq','-v','ON_ERROR_STOP=1'],{input:'BEGIN READ ONLY; '+sql+'; ROLLBACK;',encoding:'utf8'}));bindings.noWork(q);bindings.baseline(p,q);
const processes=JSON.parse(cp.execFileSync('/home/deploy/.npm-global/bin/pm2',['jlist'],{encoding:'utf8'})).map(x=>({name:x.name,pid:x.pid,status:x.pm2_env.status,restarts:x.pm2_env.restart_time}));assert(processes.length===3&&processes.every(x=>x.status==='online'&&x.restarts===0));
const report={utc:new Date().toISOString(),health,guard:{available:g.available,open:g.open,drained:g.drained,generation:g.generation,build:g.build,tasks:g.tasks.length,ledgerFault:g.ledgerFault},frontend:front,frontendBuild:build,workerHealth:true,database:q,processes};fs.writeFileSync(p+'/after-unfence.json',JSON.stringify(report,null,2));console.log(JSON.stringify(report,null,2));})().catch(e=>{console.error(e.message);process.exitCode=1});
