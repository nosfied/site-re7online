+def main(action, root):
+    # There is no CLI dry-run/simulation bypass. Tests import Operations directly.
+    root = Path(root).resolve()
+    require(str(root).startswith('/opt/re7online/backups/converta-persistent/preparations/incident-csv-operational-review-v3-20261016/'), 'not_bound_remote_preparation')
+    gates = json.loads((root.parent / 'window' / 'execution-gates.private.json').read_text())
+    require(gates.get('ownerAuthorized') and gates.get('preflightReviewed') and gates.get('artifactsVerified') and gates.get('restoreVerified') and gates.get('discrepanciesResolved'), 'execution_gates_incomplete')
+    for line in (root / 'scripts.sha256').read_text().splitlines():
+        expected, name = line.split('  ', 1)
+        require(Path(name).name == name and hashlib.sha256((root / name).read_bytes()).hexdigest() == expected, 'bound_script_hash_mismatch')
+    ops = Operations(root, System())
+    if action == 'stop-pair':
+        ops.stop()
+    elif action == 'recover-partial':
+        ops.stop(recovery=True)
+    elif action.startswith('start:'):
