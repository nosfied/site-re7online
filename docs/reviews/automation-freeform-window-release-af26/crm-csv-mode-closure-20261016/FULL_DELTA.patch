+            p=Path(r['path']);s=p.lstat();require(stat.S_ISREG(s.st_mode)and not p.is_symlink()and s.st_uid==r['uid']and stat.S_IMODE(s.st_mode)==r['mode']and sha(p)==r['sha256'],'event_consumer_live_drift')
