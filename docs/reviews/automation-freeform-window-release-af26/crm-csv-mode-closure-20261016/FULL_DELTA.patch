+        data = bindings.get(app['cwd'] + '/.data')
+        if data:
+            require(Path(app['cwd'], '.data').is_symlink() and str(Path(app['cwd'], '.data').resolve()) == data, 'auth_binding_drift')
+
+
+def validate_pre_stop(root):
+    root = Path(root)
