+            self.d.check_config(a, c)
+            require(a['pm2_env']['status'] == 'online' and a['pm2_env']['watch'] is False and a['pm2_env']['restart_time'] == 0, 'unstable_process_set')
+        g = guard_state(self.d.guard())
+        require(g['open'] == self.initial['guard']['open'] and not g['tasks'] and not g.get('ledgerFault'), 'guard_not_restored')
+        require(self.d.run(['crontab', '-l']) == (self.window / 'deploy.crontab.window').read_text(), 'window_cron_drift')
+        require(self.d.run(['cat', '/etc/cron.d/re7-converta-backup']) == (self.window / 're7-converta-backup.window').read_text(), 'window_system_cron_drift')
+        self.d.run(['sudo', '-n', 'install', '-o', 'root', '-g', 'root', '-m', '0644', str(self.window / 're7-converta-backup.before'), '/etc/cron.d/re7-converta-backup'])
+        self.d.run(['crontab', str(self.window / 'deploy.crontab.before')])
