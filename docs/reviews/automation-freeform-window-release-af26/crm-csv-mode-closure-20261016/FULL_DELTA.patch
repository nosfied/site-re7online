+def check_fence(data):
+    objects = data['nftables']
+    require(all(set(x) <= {'metainfo', 'table', 'chain', 'rule'} for x in objects), 'unknown_fence_object')
+    tables = [x['table'] for x in objects if 'table' in x]
+    chains = [x['chain'] for x in objects if 'chain' in x]
+    rules = [x['rule'] for x in objects if 'rule' in x]
+    require(len(tables) == len(chains) == len(rules) == 1, 'fence_structure_drift')
+    require(tables[0]['family'] == 'inet' and tables[0]['name'] == 're7_campaign_transition', 'fence_table_drift')
+    c = chains[0]
+    require(c['family'] == 'inet' and c['table'] == 're7_campaign_transition' and c['name'] == 'api_input' and c['type'] == 'filter' and c['hook'] == 'input' and c['prio'] == -10 and c['policy'] == 'accept', 'fence_chain_drift')
+    r = rules[0]
+    require(r['family'] == 'inet' and r['table'] == 're7_campaign_transition' and r['chain'] == 'api_input', 'fence_rule_drift')
+    expr = [x for x in r['expr'] if 'counter' not in x]
+    require(expr == [{'match': {'op': '==', 'left': {'payload': {'protocol': 'tcp', 'field': 'dport'}}, 'right': {'set': [3000, 3001]}}}, {'reject': {'type': 'tcp reset'}}], 'fence_expression_drift')
