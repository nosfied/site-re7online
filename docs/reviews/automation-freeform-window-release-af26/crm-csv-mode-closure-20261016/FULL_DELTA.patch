+    def finish(self):
+        self.scheduled().verify('contained')
+        Operations(self.root, self.d).restore_proof()
+        # The reopened guard alone does not certify release identity or health.
+        validation = json.loads((self.root / 'after-unfence.json').read_text())
+        require(validation['workerHealth'] and all(x['ok'] and x['db'] == 'ok' for x in validation['health']), 'technical_validation_failed')
