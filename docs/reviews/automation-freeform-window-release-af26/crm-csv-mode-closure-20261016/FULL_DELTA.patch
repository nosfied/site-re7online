+        require(self.d.run(['cat', '/etc/cron.d/re7-converta-backup']) == (self.window / 're7-converta-backup.before').read_text(), 'system_cron_drift')
+        require(self.d.run(['systemctl', 'show', 'pm2-deploy.service', '--property=ActiveState,UnitFileState']) == self.initial['supervision'], 'supervision_drift')
+        self.d.run(['sudo', '-n', 'nft', '--check', '--file', str(self.window / 'automation-fence.nft')])
+        self.d.run(['sudo', '-n', 'install', '-o', 'root', '-g', 'root', '-m', '0644', str(self.window / 're7-converta-backup.window'), '/etc/cron.d/re7-converta-backup'])
