+"""Single sequential executor for the reviewed V4 protocol.
+
+No simulation option exists in the CLI. Tests inject a fake Bridge directly.
+The old package is ineligible: its preflight request already exists.
+"""
+import fcntl
+import hashlib
+import json
+import os
+from pathlib import Path
+import stat
+import subprocess
+import sys
+import time
+from urllib import request
+from baseline_contract import validate_preparation, sequential
+from recovery_contract import root_mode
+
+API = 're7-whatsapp-agent'
+WORKER = 're7-whatsapp-web-worker'
+FRONT = 're7-admin-front'
+PRIV = '/usr/local/libexec/re7/incident-6683-window-control.py'
+GUARD = Path('/var/lib/re7/campaign-operations/state.json')
+PREPARATIONS = Path('/opt/re7online/backups/converta-persistent/preparations')
+PM_PID = Path('/home/deploy/.pm2/pm2.pid')
+
+
+def require(ok, code):
+    if not ok:
+        raise RuntimeError(code)
+
+
+def guard_state(value):
+    require(type(value) is dict and type(value.get('version')) is int and
+            value['version'] == 1 and type(value.get('open')) is bool and
+            type(value.get('generation')) is int and value['generation'] >= 0 and
+            type(value.get('tasks')) is dict and type(value.get('audit')) is list,
+            'guard_schema_invalid')
+    return value
+
+
+def same_identity(saved, current):
+    return bool(saved and current and saved['ticks'] == current['ticks'] and
+                current['state'] != 'Z')
+
+
+class Bridge:
+    def __init__(self, root):
+        self.root = Path(root).resolve()
+        require(self.root.parent == PREPARATIONS and
+                self.root.name.startswith('incident-6683-v4-'), 'preparation_path_denied')
+        self.switch = self.root / 'switch'
+        self.window = self.root / 'window'
+
+    def run(self, args, *, input_text=None, cwd=None):
+        from child_transport import command
+        args = command(__phase_authority__, args)
+        result = subprocess.run(args, input=input_text, text=True,
+                                stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+                                cwd=cwd, check=True)
+        return result.stdout
+
+    def guard(self):
+        return guard_state(json.loads(GUARD.read_text()))
+
+    def apps(self):
+        pm = '/home/deploy/.npm-global/bin/pm2'
+        return {a['name']: a for a in json.loads(self.run([pm, 'jlist']))}
+
+    def identity(self, pid):
+        try:
+            data = Path('/proc', str(pid), 'stat').read_text().rsplit(')', 1)[1].split()
+            return {'state': data[0], 'ticks': data[19]}
+        except FileNotFoundError:
+            return None
+
+    def expected_config(self, mode, file):
+        return {a['name']: a for a in json.loads(
+            (self.root / mode / file).read_text())['apps']}
+
+    def app_matches(self, mode, name, config):
+        module = __phase_loader__.mode_module(mode)
+        app = self.apps().get(name)
+        if app is None: return False
+        try: module.Operations(self.root / mode, module.System()).config(app, config[name])
+        except (RuntimeError, KeyError): return False
+        return True
+
+    def node(self, mode, script):
+        require(mode in {'switch', 'return', 'return-partial', 'return-before-commit'} and
+                script in {'close.cjs', 'validate.cjs', 'open.cjs'},
+                'node_step_denied')
+        try:
+            return self.run(['node', str(self.root / mode / script)])
+        except subprocess.CalledProcessError as error:
+            # Keep the exact output in the private preparation, never in the
+            # public journal or exception. validate.cjs may expose DB IDs.
+            path = self.window / 'step-output.private.jsonl'
+            stdout = error.stdout or ''
+            stderr = error.stderr or ''
+            record = {'utc': time.time(), 'mode': mode, 'step': script,
+                      'exitCode': error.returncode,
+                      'stdout': stdout[:16384], 'stderr': stderr[:16384],
+                      'stdoutBytes': len(stdout.encode()),
+                      'stderrBytes': len(stderr.encode()),
+                      'stdoutSha256': hashlib.sha256(stdout.encode()).hexdigest(),
+                      'stderrSha256': hashlib.sha256(stderr.encode()).hexdigest(),
+                      'outputTruncated': (len(stdout) > 16384 or len(stderr) > 16384)}
+            fd = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_NOFOLLOW,
+                         0o600)
+            try:
+                info = os.fstat(fd)
+                require(stat.S_ISREG(info.st_mode) and info.st_nlink == 1 and
+                        info.st_uid == os.getuid() and info.st_mode & 0o077 == 0,
+                        'step_output_permissions')
+                os.write(fd, (json.dumps(record, sort_keys=True) + '\n').encode())
+                os.fsync(fd)
+            finally:
+                os.close(fd)
+            raise RuntimeError(f'step_failed:{mode}/{script}:exit={error.returncode}') from None
+
+    def private_record(self, name, record):
+        from privileged_output import private_record
+        private_record(self.window, name, record)
+
+    def privileged(self, action):
+        from privileged_output import run_privileged
+        args = ['sudo', '-n', '/usr/bin/python3', '-I', '-S', PRIV, action]
+        return run_privileged(args, self.window, action).decode()
+
+    def protocol(self, mode, action):
+        root = self.root / mode
+        delegated = root / 'delegated.py'
+        phase = 'request'
+        try:
+            payload = json.loads(self.run(['python3', str(delegated), 'request', action, str(root)]))
+            phase = 'owner-read'
+            read_action = 'check-absent' if action in {
+                'preflight', 'prepare-containment', 'verify-unfenced', 'restore-controls'
+            } else 'check-present'
+            proof = self.privileged(read_action)
+            phase = 'record'
+            self.run(['python3', str(delegated), 'record', action, str(root), payload['nonce']],
+                     input_text=proof)
+            phase = 'execute'
+            self.run(['python3', str(delegated), 'execute', action, str(root)])
+        except Exception as error:
+            # A denial before start-intent was previously reported only as a
+            # generic CalledProcessError. Keep the cause private and durable.
+            stdout = getattr(error, 'stdout', None) or ''
+            stderr = getattr(error, 'stderr', None) or ''
+            record = {'utc': time.time(), 'mode': mode, 'action': action,
+                      'phase': phase, 'errorType': type(error).__name__,
+                      'exitCode': getattr(error, 'returncode', None),
+                      'stdout': stdout[:16384], 'stderr': stderr[:16384],
+                      'stdoutBytes': len(stdout.encode()),
+                      'stderrBytes': len(stderr.encode()),
+                      'stdoutSha256': hashlib.sha256(stdout.encode()).hexdigest(),
+                      'stderrSha256': hashlib.sha256(stderr.encode()).hexdigest(),
+                      'outputTruncated': len(stdout) > 16384 or len(stderr) > 16384}
+            path = self.window / 'protocol-output.private.jsonl'
+            fd = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_NOFOLLOW, 0o600)
+            try:
+                info = os.fstat(fd)
+                require(stat.S_ISREG(info.st_mode) and info.st_nlink == 1 and
+                        info.st_uid == os.getuid() and info.st_mode & 0o077 == 0,
+                        'protocol_output_permissions')
+                os.write(fd, (json.dumps(record, sort_keys=True) + '\n').encode())
+                os.fsync(fd)
+            finally:
+                os.close(fd)
+            raise RuntimeError(f'protocol_failed:{mode}/{action}/{phase}') from None
+
+    def scheduled_controls(self):
+        from scheduled_controls import ScheduledControls
+        return ScheduledControls(self.window, lambda args, text=None: self.run(args, input_text=text))
+
+    def restore_guard(self, config_file):
+        g = self.guard()
+        require(not g['open'] and g['generation'] == 38 and not g['tasks'] and not g.get('ledgerFault'), 'closed_guard_restoration_drift')
+        return g
+
+    def pre_unfence(self, mode):
+        """Checks possible under nft; port 3001 HTTP is deliberately deferred."""
+        require(mode in {'switch', 'return', 'return-partial', 'return-before-commit'}, 'mode_denied')
+        self.privileged('check-present')
+        guard = self.guard()
+        require(not guard['open'] and not guard['tasks'] and
+                not guard.get('ledgerFault'), 'guard_not_closed_before_unfence')
+        config = self.expected_config(mode, 'candidate.config.private.json')
+        apps = self.apps()
+        require(set(apps) == {API, WORKER, FRONT}, 'incomplete_process_set')
+        for name in (API, WORKER):
+            marker = json.loads((self.root / mode / ('started-' + name + '.json')).read_text())
+            require(apps[name]['pid'] == marker['pid'] and
+                    same_identity(marker['identity'], self.identity(marker['pid'])) and
+                    self.app_matches(mode, name, config), 'successor_identity_or_config_drift')
+        worker_env = config[WORKER]['env']
+        host = worker_env['WHATSAPP_WEB_WORKER_CONTROL_HOST']
+        port = int(worker_env['WHATSAPP_WEB_WORKER_CONTROL_PORT'])
+        require(host == '127.0.0.1' and port > 0 and port != 3001,
+                'worker_control_binding_drift')
+        probe = request.Request(f'http://{host}:{port}/health', headers={
+            'Authorization': 'Bearer ' + worker_env['WHATSAPP_WEB_WORKER_CONTROL_TOKEN']})
+        try:
+            with request.urlopen(probe, timeout=5) as response:
+                payload = json.load(response)
+                require(response.status == 200 and payload.get('ok') is True,
+                        'worker_control_unhealthy')
+        except Exception:
+            raise RuntimeError('worker_control_unavailable_under_fence') from None
+        self.capture_worker_before_unfence(mode, apps[WORKER], config[WORKER])
+
+    def worker_capture_observation(self, mode, app, config):
+        module = __phase_loader__.mode_module(mode)
+        system = module.System()
+        policy = json.loads((self.window / 'privileged-policy.private.json').read_text())
+        apps = self.apps()
+        require(set(apps) == {API, WORKER, FRONT}, 'incomplete_process_set')
+        targets = self.expected_config(mode, 'candidate.config.private.json')
+        require(all(self.app_matches(mode, n, targets) for n in apps), 'capture_release_drift')
+        require(apps[WORKER]['pid'] == app['pid'], 'worker_capture_identity_drift')
+        front = policy['sourceProcesses'][FRONT]
+        require(apps[FRONT]['pid'] == front['pid'] and
+                same_identity(front, self.identity(front['pid'])), 'frontend_identity_changed')
+        daemon_pid = int(PM_PID.read_text().strip())
+        daemon = self.identity(daemon_pid)
+        require(daemon_pid == policy['pm2Daemon']['pid'] and
+                same_identity(policy['pm2Daemon'], daemon), 'worker_capture_daemon_drift')
+        guard = self.guard()
+        require(not guard['open'] and not guard['tasks'] and not guard.get('ledgerFault'),
+                'guard_not_closed_before_unfence')
+        pid = app['pid']
+        identity = self.identity(pid)
+        marker = json.loads((self.root / mode / ('started-' + WORKER + '.json')).read_text())
+        require(marker['pid'] == pid and same_identity(marker['identity'], identity),
+                'worker_capture_identity_drift')
+        tree = system.tree(pid)
+        require(str(pid) in tree and all(v and v['state'] != 'Z' for v in tree.values()),
+                'worker_capture_tree_ambiguous')
+        sockets = set()
+        for child in tree:
+            folder = Path('/proc', child, 'fd')
+            require(folder.is_dir(), 'worker_capture_fd_missing')
+            try:
+                for fd in folder.iterdir():
+                    target = os.readlink(fd)
+                    if target.startswith('socket:['):
+                        sockets.add(target[8:-1])
+            except FileNotFoundError:
+                raise RuntimeError('worker_capture_fd_changed') from None
+        identity_after = self.identity(pid)
+        tree_after = system.tree(pid)
+        # R/S is scheduling state, not process identity. Zombies still deny.
+        require(same_identity(identity, identity_after) and
+                all(v and v['state'] != 'Z' for v in tree_after.values()) and
+                {k:v['ticks'] for k,v in tree.items()} ==
+                {k:v['ticks'] for k,v in tree_after.items()}, 'worker_capture_changed')
+        require(os.getpgid(pid) == os.getsid(pid) == pid, 'worker_capture_session_ambiguous')
+        expected = policy['targetProcesses'][root_mode(mode)][WORKER]
+        require(config['cwd'] == expected['cwd'] and config['script'] == expected['script'] and
+                hashlib.sha256(Path(config['script']).read_bytes()).hexdigest() ==
+                expected['sha256'], 'capture_release_drift')
+        record = {'status': 'running-captured', 'pid': pid, 'ticks': identity['ticks'],
+                  'pgid': pid, 'sid': pid, 'uid': Path('/proc', str(pid)).stat().st_uid,
+                  'tree': {k:v['ticks'] for k,v in tree.items()}, 'socketIds': sorted(sockets),
+                  'cwd': config['cwd'], 'script': config['script'],
+                  'daemon': {'pid': daemon_pid, 'ticks': daemon['ticks']}}
+        api_marker = json.loads((self.root / mode / ('started-' + API + '.json')).read_text())
+        api_identity = self.identity(apps[API]['pid'])
+        require(apps[API]['pid'] == api_marker['pid'] and
+                same_identity(api_marker['identity'], api_identity), 'api_capture_identity_drift')
+        return record, guard['generation'], (apps[API]['pid'], api_identity['ticks'])
+
+    def capture_worker_before_unfence(self, mode, app, config):
+        path = self.root / root_mode(mode) / 'worker-before-unfence.private.json'
+        previous = None
+        if path.exists():
+            info = path.lstat()
+            require(stat.S_ISREG(info.st_mode) and info.st_nlink == 1 and
+                    info.st_uid == os.getuid() and not info.st_mode & 0o077,
+                    'worker_capture_file_unsafe')
+            previous = json.loads(path.read_text())
+        expected_generation = self.guard()['generation']
+        for attempt in range(1, 4):
+            self.privileged('check-present')
+            try:
+                first = self.worker_capture_observation(mode, app, config)
+                second = self.worker_capture_observation(mode, app, config)
+                self.privileged('check-present')
+                require(first[1] == second[1] == expected_generation, 'capture_guard_generation_drift')
+                require(first == second, 'worker_capture_churn')
+                record, generation, _ = second
+                if previous:
+                    require(all(record[k] == previous[k] for k in record if k != 'socketIds'),
+                            'worker_capture_identity_or_tree_drift')
+                archive = None
+                if previous:
+                    digest = hashlib.sha256(path.read_bytes()).hexdigest()
+                    archive = path.with_name('worker-before-unfence.' + str(time.time_ns()) +
+                                             '.' + digest + '.private.json')
+                    require(not archive.exists(), 'worker_capture_archive_exists')
+                    os.rename(path, archive)
+                fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
+                try:
+                    os.write(fd, (json.dumps(record, sort_keys=True) + '\n').encode())
+                    os.fsync(fd)
+                finally:
+                    os.close(fd)
+                self.private_record('sequencer.journal.jsonl', {
+                    'utc': time.time(), 'event': 'worker_capture_refreshed', 'mode': mode,
+                    'attempt': attempt, 'generation': generation,
+                    'captureSha256': hashlib.sha256(path.read_bytes()).hexdigest(),
+                    'previousSha256': digest if previous else None})
+                return
+            except RuntimeError as error:
+                if str(error) not in {'worker_capture_churn', 'worker_capture_fd_changed',
+                                      'worker_capture_changed'}:
+                    raise
+                self.private_record('sequencer.journal.jsonl', {
+                    'utc': time.time(), 'event': 'worker_capture_sample_denied', 'mode': mode,
+                    'attempt': attempt, 'reason': str(error)})
+        raise RuntimeError('worker_capture_unstable_after_3_attempts')
+
+    def renewed_unfence(self, mode):
+        # authorize-* has already pinned the mode. Retry only failures known to
+        # occur BEFORE nft deletion; never retry an unknown/partial root action.
+        for attempt in range(1, 4):
+            self.pre_unfence(mode)
+            try:
+                self.privileged('unfence')
+                return
+            except RuntimeError as error:
+                if str(error) not in {
+                    'privileged_failed:unfence:exit=1:worker_capture_sockets_drift',
+                    'privileged_failed:unfence:exit=1:worker_capture_fd_changed'}:
+                    raise
+                self.private_record('sequencer.journal.jsonl', {
+                    'utc': time.time(), 'event': 'unfence_capture_denied', 'mode': mode,
+                    'attempt': attempt})
+        raise RuntimeError('unfence_capture_unstable_after_3_attempts')
