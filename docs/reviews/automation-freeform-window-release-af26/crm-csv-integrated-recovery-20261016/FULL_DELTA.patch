+        require(sha(file) == expected_digest, 'recovery_contract_hash_drift')
+        self.seal = read(file)
+        require(self.seal['version'] == 1, 'recovery_contract_version')
+        # Pins anchor the complete canonical checker inputs; no filtered/empty
+        # immutable set and no unsealed manifest may replace the original ones.
+        for name, key in (('csv-contract.private.json', 'originalCanonicalSha256'),
+                          ('sequencer-manifest.json', 'originalSequencerManifestSha256')):
+            read_permission(self.window / name)
+            require(sha(self.window / name) == self.seal[key], 'original_canonical_input_drift')
+        require(sha(self.root / 'original-preparation-review.sha256') == self.seal['originalReviewSha256'],
+                'original_review_drift')
+        check_original(self.root, live=True)
+        required = {'window/source.profile.private.json', 'window/target.profile.private.json',
+                    'window/csv-baseline.private.json', 'window/initial.private.json',
+                    'window/mode-names.private.json', 'window/mode-manifest-v4.json',
+                    'window/deploy.crontab.before', 'window/deploy.crontab.window',
+                    'window/re7-converta-backup.before', 'window/re7-converta-backup.window'}
+        required |= {m + '/' + n for m in MODES for n in
