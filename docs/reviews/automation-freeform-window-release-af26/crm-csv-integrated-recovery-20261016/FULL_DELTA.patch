+        review_required = required | {'window/csv-contract.private.json',
+            'window/sequencer-manifest.json', 'window/original-bindings/path-bindings.private.json',
+            'window/db-owner-bindings.private.json', 'window/event-consumer-binding.private.json'}
+        require(review_required <= declared, 'original_review_coverage')
+        refs = self.seal['filesSha256']
+        require(set(refs) == required, 'recovery_reference_coverage')
+        for name, digest in refs.items():
+            read_permission(self.root / name)
+            require(sha(self.root / name) == digest, 'recovery_reference_drift:' + name)
