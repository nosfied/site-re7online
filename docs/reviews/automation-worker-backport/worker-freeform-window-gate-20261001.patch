+  const token = params.expected;
+  if (invalidatedTokens.has(token) || token.clientId !== params.clientId || token.waId !== params.waId) return false;
+  const write = await params.prisma.conversationRuntimeState.updateMany({
+    where: { ...tokenWhere(token), OR: [{ lastOutboundAt: null }, { lastOutboundAt: { lte: params.sentAt } }] },
+    data: { provider: "web_session", channelAccountId: params.channelAccountId,
+      lastOutboundAt: params.sentAt, lastOutboundMessageId: params.messageId },
+  });
+  if (write.count !== 1) { invalidateRuntimeWriteToken(token); return false; }
+  const row = await params.prisma.conversationRuntimeState.findUnique({
+    where: { clientId_waId: { clientId: params.clientId, waId: params.waId } },
+    select: runtimeWriteTokenSelect,
+  });
+  if (!row) { invalidateRuntimeWriteToken(token); return false; }
+  Object.assign(token, captureRuntimeWriteToken(row));
+  return true;
