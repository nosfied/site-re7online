+  add("flowStep", data.flowStep as never);
+  add("chatbotNodeId", data.chatbotNodeId as never);
+  add("chatbotActive", data.chatbotActive as never);
+  add("answers", data.answers as never, "json");
+  add("mode", data.mode as never);
+  add("assignedUserId", data.assignedUserId as never);
+  add("assignedTo", data.assignedTo as never);
+  add("assignedAt", data.assignedAt as never, "date");
+  add("departmentId", data.departmentId as never);
+  add("queueId", data.queueId as never);
+  add("status", data.status as never, "status");
