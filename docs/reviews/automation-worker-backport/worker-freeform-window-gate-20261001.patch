+  if (invalidatedTokens.has(token) || token.clientId !== params.clientId || token.waId !== params.waId) return false;
+  const rows = await params.prisma.$queryRaw<RuntimeWriteToken[]>`
+    UPDATE "ConversationRuntimeState"
+    SET "provider" = 'web_session', "channelAccountId" = ${params.channelAccountId},
+        "lastOutboundAt" = ${dateParam(params.sentAt)}, "lastOutboundMessageId" = ${params.messageId}, "updatedAt" = ${dateParam(new Date())}
+    WHERE ${tokenPredicate(token)}
+      AND ("lastOutboundAt" IS NULL OR "lastOutboundAt" <= ${params.sentAt})
+    RETURNING ${returnRuntimeWriteToken}
+  `;
