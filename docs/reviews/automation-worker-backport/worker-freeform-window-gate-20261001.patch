+export async function recordOwnRuntimeOutboundActivity(params: {
+  prisma: RuntimeWritePrisma;
+  clientId: string;
+  waId: string;
+  expected: RuntimeWriteToken;
+  sentAt: Date;
+  messageId: string;
+  channelAccountId: string;
